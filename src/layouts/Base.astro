---
import '../styles/global.css';
import '../styles/redesign.css';
import las from '../data/las.json';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
}
const { title, description, canonical, robots = 'index, follow, max-image-preview:large, max-snippet:-1' } = Astro.props;
const url = canonical ?? Astro.url.href;
const ogImage = 'https://catchment.school/og-default.png';

const totalSchools = (las as any[]).reduce((s, la) => s + la.count, 0);

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "catchment.school",
  "url": "https://catchment.school",
  "description": "Find school catchment areas, admissions guidance and school profiles for every school in England and Wales.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": "https://catchment.school/postcode?pc={search_term_string}" },
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "catchment.school",
  "url": "https://catchment.school",
  "logo": "https://catchment.school/favicon.svg",
  "description": "Free school catchment area checker for England & Wales. Data from DfE GIAS under the Open Government Licence.",
  "areaServed": "GB",
  "knowsAbout": ["School catchment areas", "School admissions", "Primary schools", "Secondary schools", "Ofsted ratings"],
  "founder": {
    "@type": "Person",
    "name": "Sunny Patel",
    "jobTitle": "Founder",
    "url": "https://sunnypatel.co.uk",
    "sameAs": ["https://sunnypatel.co.uk", "https://www.linkedin.com/in/sunny-patel-seo/"]
  },
  "sameAs": ["https://sunnypatel.co.uk"]
};

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="en-GB" href={url} />
  <link rel="alternate" hreflang="x-default" href={url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content={robots} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="catchment.school" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <slot name="head" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E79ZS7MK0H"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-E79ZS7MK0H');
  </script>
</head>
<body>

  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:text-black focus:px-3 focus:py-1 focus:rounded">Skip to content</a>

  <div class="topbar">
    <div class="topbar-inner">
      <span>A free, independent guide for parents - <em>updated each admissions cycle.</em></span>
      <span>{totalSchools.toLocaleString('en-GB')} schools · England &amp; Wales</span>
    </div>
  </div>

  <header class="masthead">
    <div class="masthead-inner">
      <nav>
        <a href="/postcode" class={Astro.url.pathname.startsWith('/postcode') ? 'active' : ''}>Postcode search</a>
        <a href="/council" class={Astro.url.pathname.startsWith('/council') ? 'active' : ''}>Browse councils</a>
        <a href="/guides" class={Astro.url.pathname.startsWith('/guides') ? 'active' : ''}>Guides</a>
      </nav>
      <a href="/" class="wordmark">
        <span class="glyph" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
            <path d="M17 4 L29 11 L29 23 L17 30 L5 23 L5 11 Z" fill="none" stroke="#16202B" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M17 4 L29 11 L17 18 L5 11 Z" fill="#2B5440"/>
            <circle cx="17" cy="20" r="2.6" fill="#C8593A"/>
          </svg>
        </span>
        <span>catchment<span class="dot">.school</span></span>
      </a>
      <div class="right-tools">
        <a class="pill-link primary" href="/council/cardiff/">View Cardiff →</a>
      </div>
    </div>
  </header>

  <main id="main">
    {isHome ? <slot /> : (
      <div class="container" style="padding-top:40px;padding-bottom:64px;">
        <slot />
      </div>
    )}
  </main>

  <section class="newsletter-bar">
    <div class="container" style="max-width:680px;text-align:center;padding:48px 20px;">
      <h2 style="font-size:22px;font-weight:700;margin:0 0 8px;color:#16202B;">Get admissions updates by email</h2>
      <p style="font-size:15px;color:#5a6672;margin:0 0 20px;line-height:1.5;">Join parents who get catchment boundary changes and key admissions dates - free, once per term.</p>
      <form
        action="https://api.staticforms.xyz/submit"
        method="POST"
        style="display:flex;gap:10px;max-width:480px;margin:0 auto;"
        id="footer-email-form"
      >
        <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
        <input type="hidden" name="_site" value="catchment.school" />
        <input type="hidden" name="subject" value="Newsletter signup (catchment.school)" />
        <input type="hidden" name="redirectTo" value="https://catchment.school/?subscribed=1" />
        <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" />
        <input
          type="email"
          name="email"
          placeholder="Your email address"
          required
          style="flex:1;padding:12px 16px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;outline:none;"
        />
        <button
          type="submit"
          style="background:#2B5440;color:#fff;border:none;padding:12px 24px;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap;"
        >Subscribe</button>
      </form>
      <p style="font-size:12px;color:#94a3b8;margin:12px 0 0;">No spam. Unsubscribe any time.</p>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-top">
        <div class="about">
          <a href="/" class="wordmark" style="justify-content:flex-start;">
            <span class="glyph">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
                <path d="M17 4 L29 11 L29 23 L17 30 L5 23 L5 11 Z" fill="none" stroke="#16202B" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="M17 4 L29 11 L17 18 L5 11 Z" fill="#2B5440"/>
                <circle cx="17" cy="20" r="2.6" fill="#C8593A"/>
              </svg>
            </span>
            <span>catchment<span class="dot">.school</span></span>
          </a>
          <p>Free school catchment area checker for England &amp; Wales. School data sourced from the Department for Education under the Open Government Licence. Not affiliated with any school, local authority or government body.</p>
        </div>
        <div>
          <h4>Browse</h4>
          <ul>
            <li><a href="/council">Schools by council</a></li>
            <li><a href="/area">Schools by town</a></li>
            <li><a href="/postcode">Search by postcode</a></li>
          </ul>
        </div>
        <div>
          <h4>Guides</h4>
          <ul>
            <li><a href="/guides/how-school-catchment-areas-work">How catchment works</a></li>
            <li><a href="/guides/primary-school-catchment">Primary admissions</a></li>
            <li><a href="/guides/secondary-school-catchment">Secondary admissions</a></li>
            <li><a href="/guides/school-admissions-timeline">Admissions timeline</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/about">Where our data comes from</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/about">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span><em>© {new Date().getFullYear()} catchment.school</em></span>
        <span>School data from GIAS / DfE under the Open Government Licence v3.0</span>
      </div>
    </div>
  </footer>

</body>
</html>
