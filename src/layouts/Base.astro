---
import '../styles/global.css';
import '../styles/redesign.css';
import las from '../data/las.json';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
}
const { title, description, canonical, robots = 'index, follow, max-image-preview:large, max-snippet:-1' } = Astro.props;
const url = canonical ?? Astro.url.href;
const ogImage = 'https://catchment.school/og-default.png';

const totalSchools = (las as any[]).reduce((s, la) => s + la.count, 0);

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "catchment.school",
  "url": "https://catchment.school",
  "description": "Find school catchment areas, admissions guidance and school profiles for every school in England and Wales.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": "https://catchment.school/postcode?pc={search_term_string}" },
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "catchment.school",
  "url": "https://catchment.school",
  "logo": "https://catchment.school/favicon.svg",
  "description": "Free school catchment area checker for England & Wales. Data from DfE GIAS under the Open Government Licence.",
  "areaServed": "GB",
  "knowsAbout": ["School catchment areas", "School admissions", "Primary schools", "Secondary schools", "Ofsted ratings"],
  "founder": {
    "@type": "Person",
    "name": "Sunny Patel",
    "jobTitle": "Founder",
    "url": "https://sunnypatel.co.uk",
    "sameAs": ["https://sunnypatel.co.uk", "https://www.linkedin.com/in/sunny-patel-co-uk/"]
  },
  "sameAs": ["https://sunnypatel.co.uk"]
};

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="en-GB" href={url} />
  <link rel="alternate" hreflang="x-default" href={url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content={robots} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="catchment.school" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <slot name="head" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E79ZS7MK0H"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-E79ZS7MK0H');
  </script>
</head>
<body>

  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:text-black focus:px-3 focus:py-1 focus:rounded">Skip to content</a>

  <div class="dl-banner" id="dl-banner" role="region" aria-label="School application deadlines">
    <div class="dl-banner-inner">
      <p class="dl-text" id="dl-text">School application deadlines in England: 31 October for secondary, 15 January for primary. <a href="https://www.gov.uk/schools-admissions" rel="nofollow noopener" target="_blank">Apply through your council</a>.</p>
      <a class="dl-cta" href="/postcode/">Check your postcode</a>
      <button type="button" class="dl-close" id="dl-close" aria-label="Dismiss deadline banner">&times;</button>
    </div>
  </div>
  <script is:inline>
  (function () {
    var b = document.getElementById('dl-banner');
    if (!b) return;
    var KEY = 'dl-banner-dismissed';
    var DAY = 86400000;
    var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var GOV = { sec: 'https://www.gov.uk/apply-for-secondary-school-place', pri: 'https://www.gov.uk/apply-for-primary-school-place', late: 'https://www.gov.uk/schools-admissions' };
    function today() {
      var q = /[?&]bannerdate=(\d{4})-(\d{2})-(\d{2})/.exec(location.search);
      if (q) return Date.UTC(+q[1], +q[2] - 1, +q[3]);
      try {
        var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: 'numeric', day: 'numeric' }).formatToParts(new Date());
        var o = {}; p.forEach(function (x) { o[x.type] = +x.value; });
        return Date.UTC(o.year, o.month - 1, o.day);
      } catch (e) { var n = new Date(); return Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()); }
    }
    // Offer day: nominal date, or next Monday if it falls on a weekend (bank holidays not modelled).
    function offer(y, m, d) { var t = Date.UTC(y, m, d), w = new Date(t).getUTCDay(); if (w === 6) t += 2 * DAY; if (w === 0) t += DAY; return t; }
    function fmt(t) { var x = new Date(t); return DAYS[x.getUTCDay()] + ' ' + x.getUTCDate() + ' ' + MONTHS[x.getUTCMonth()]; }
    function closes(phase, t, now) {
      var n = Math.round((t - now) / DAY);
      if (n <= 0) { var x = new Date(t); return phase + ' school applications in England close today, ' + x.getUTCDate() + ' ' + MONTHS[x.getUTCMonth()] + '. Late applications go to your council with lower priority.'; }
      return phase + ' school applications in England close on ' + fmt(t) + ' (' + (n === 1 ? 'tomorrow' : 'in ' + n + ' days') + '). Apply through your council.';
    }
    var now = today(), y = new Date(now).getUTCFullYear(), m = new Date(now).getUTCMonth();
    var msg, href, label, id;
    var secDl = Date.UTC(y, 9, 31), priDl = Date.UTC(y, 0, 15);
    if (now <= priDl) { id = 'pri'; href = GOV.pri; label = 'Apply for a primary place'; msg = closes('Primary', priDl, now); }
    else if (now <= offer(y, 2, 1)) { var o = offer(y, 2, 1); id = 'secoffer'; href = GOV.sec; label = 'Secondary applications'; msg = 'Secondary school offers in England come out on ' + fmt(o) + '. Check your council for the time they are sent.'; }
    else if (now <= offer(y, 3, 16)) { var o2 = offer(y, 3, 16); id = 'prioffer'; href = GOV.pri; label = 'Primary applications'; msg = 'Primary school offers in England come out on ' + fmt(o2) + '. Check your council for the time they are sent.'; }
    else if (m < 8) { id = 'late'; href = GOV.late; label = 'Late applications'; msg = 'Missed a deadline? Late applications and waiting lists are handled by your council. Contact them as soon as you can.'; }
    else if (now <= secDl) { id = 'sec'; href = GOV.sec; label = 'Apply for a secondary place'; msg = closes('Secondary', secDl, now); }
    else { var nd = Date.UTC(y + 1, 0, 15); id = 'pri'; href = GOV.pri; label = 'Apply for a primary place'; msg = closes('Primary', nd, now); }
    var key = id + '-' + y;
    try { if (localStorage.getItem(KEY) === key) { b.hidden = true; return; } } catch (e) {}
    var txt = document.getElementById('dl-text');
    txt.textContent = msg + ' ';
    var a = document.createElement('a'); a.href = href; a.rel = 'nofollow noopener'; a.target = '_blank'; a.textContent = 'On GOV.UK'; txt.appendChild(a);
    document.getElementById('dl-close').addEventListener('click', function () {
      b.hidden = true;
      try { localStorage.setItem(KEY, key); } catch (e) {}
    });
  })();
  </script>

  <div class="topbar">
    <div class="topbar-inner">
      <span>A free, independent guide for parents - <em>updated each admissions cycle.</em></span>
      <span>{totalSchools.toLocaleString('en-GB')} schools · England &amp; Wales</span>
    </div>
  </div>

  <header class="masthead">
    <div class="masthead-inner">
      <nav>
        <a href="/postcode" class={Astro.url.pathname.startsWith('/postcode') ? 'active' : ''}>Postcode search</a>
        <a href="/council" class={Astro.url.pathname.startsWith('/council') ? 'active' : ''}>Browse councils</a>
        <a href="/guides" class={Astro.url.pathname.startsWith('/guides') ? 'active' : ''}>Guides</a>
      </nav>
      <a href="/" class="wordmark">
        <span class="glyph" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
            <path d="M17 4 L29 11 L29 23 L17 30 L5 23 L5 11 Z" fill="none" stroke="#16202B" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M17 4 L29 11 L17 18 L5 11 Z" fill="#2B5440"/>
            <circle cx="17" cy="20" r="2.6" fill="#C8593A"/>
          </svg>
        </span>
        <span>catchment<span class="dot">.school</span></span>
      </a>
      <div class="right-tools">
        <a class="pill-link primary" href="/postcode/">Search by postcode →</a>
      </div>
    </div>
  </header>

  <main id="main">
    {isHome ? <slot /> : (
      <div class="container" style="padding-top:40px;padding-bottom:64px;">
        <slot />
      </div>
    )}
  </main>

  <section class="newsletter-bar">
    <div class="container" style="max-width:680px;text-align:center;padding:48px 20px;">
      <h2 style="font-size:22px;font-weight:700;margin:0 0 8px;color:#16202B;">Get admissions updates by email</h2>
      <p style="font-size:15px;color:#5a6672;margin:0 0 20px;line-height:1.5;">Join parents who get catchment boundary changes and key admissions dates - free, once per term.</p>
      <form
        action="https://emailit-worker.sunnypat81.workers.dev/"
        method="POST"
        style="display:flex;gap:10px;max-width:480px;margin:0 auto;"
        id="footer-email-form"
      >
        <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
        <input type="hidden" name="_site" value="catchment.school" />
        <input type="hidden" name="subject" value="Newsletter signup (catchment.school)" />
        <input type="hidden" name="redirectTo" value="https://catchment.school/?subscribed=1" />
        <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" />
        <input
          type="email"
          name="email"
          placeholder="Your email address"
          required
          style="flex:1;padding:12px 16px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;outline:none;"
        />
        <button
          type="submit"
          style="background:#2B5440;color:#fff;border:none;padding:12px 24px;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap;"
        >Subscribe</button>
      </form>
      <p style="font-size:12px;color:#94a3b8;margin:12px 0 0;">No spam. Unsubscribe any time.</p>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-top">
        <div class="about">
          <a href="/" class="wordmark" style="justify-content:flex-start;">
            <span class="glyph">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
                <path d="M17 4 L29 11 L29 23 L17 30 L5 23 L5 11 Z" fill="none" stroke="#16202B" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="M17 4 L29 11 L17 18 L5 11 Z" fill="#2B5440"/>
                <circle cx="17" cy="20" r="2.6" fill="#C8593A"/>
              </svg>
            </span>
            <span>catchment<span class="dot">.school</span></span>
          </a>
          <p>Free school catchment area checker for England &amp; Wales. School data sourced from the Department for Education under the Open Government Licence. Not affiliated with any school, local authority or government body.</p>
        </div>
        <div>
          <h4>Browse</h4>
          <ul>
            <li><a href="/council">Schools by council</a></li>
            <li><a href="/area">Schools by town</a></li>
            <li><a href="/postcode">Search by postcode</a></li>
          </ul>
        </div>
        <div>
          <h4>Guides</h4>
          <ul>
            <li><a href="/guides/how-school-catchment-areas-work">How catchment works</a></li>
            <li><a href="/guides/primary-school-catchment">Primary admissions</a></li>
            <li><a href="/guides/secondary-school-catchment">Secondary admissions</a></li>
            <li><a href="/guides/school-admissions-timeline">Admissions timeline</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/about">Where our data comes from</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/about">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span><em>© {new Date().getFullYear()} catchment.school</em></span>
        <span>School data from GIAS / DfE under the Open Government Licence v3.0</span>
      </div>
    </div>
  </footer>

</body>
</html>
