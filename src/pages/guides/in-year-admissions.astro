    },
    {
      "@type": "Question",
      "name": "Can I apply in-year for a school that was full during the normal round?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. In-year applications are assessed at the time of application. If a place has become available since the normal round, the school may now have capacity. If the school is still full, you can join the waiting list and appeal." }
    }
  ]
