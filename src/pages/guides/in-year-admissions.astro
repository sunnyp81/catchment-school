  "datePublished": "2026-03-15",
  "dateModified": "2026-05-26",
  "inLanguage": "en-GB",
  "mainEntityOfPage": "https://catchment.school/guides/in-year-admissions"
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Apply for In-Year School Admission in England",
  "description": "Step-by-step guide to applying for a mid-year school place in England.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Find the right application form",
      "text": "Go to your local authority's website and search for 'in-year application' or 'mid-year school transfer'. If the school is an academy or free school not covered by a coordinated scheme, contact the school directly for their application form."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Submit with supporting evidence",
      "text": "If you are moving house, include a signed tenancy agreement or exchange of contracts. If applying for welfare or medical reasons, include a supporting letter from a professional such as a GP or social worker."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Wait for the decision",
      "text": "The admissions authority must notify you of the outcome within 15 school days of receiving a completed application."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "If refused, appeal and join the waiting list",
      "text": "You have 20 school days from the refusal letter to lodge a formal appeal. You can also ask to be added to the school's waiting list, where your position is determined by the school's published oversubscription criteria — not by when you joined the list."
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is in-year admission?",
      "acceptedAnswer": { "@type": "Answer", "text": "In-year admission is the process of applying for a school place outside the normal admissions round — for example, when a family moves house during the school year, or when a child needs to change school for another reason. Applications can be made at any point during the academic year." }
    },
    {
      "@type": "Question",
      "name": "Who do I apply to for an in-year place?",
      "acceptedAnswer": { "@type": "Answer", "text": "It depends on the school. For community and voluntary controlled schools, you apply to the local authority. For academies, free schools, foundation schools, and voluntary aided schools, you apply directly to the school. Some local authorities operate a coordinated in-year scheme covering all school types — check with your local authority first." }
    },
    {
      "@type": "Question",
      "name": "How long does an in-year application take?",
      "acceptedAnswer": { "@type": "Answer", "text": "The admissions authority must notify you of the decision within 15 school days of receiving a completed application. If the place is refused, you have 20 school days to lodge an appeal." }
    },
    {
      "@type": "Question",
      "name": "What happens if no school near me has places?",
