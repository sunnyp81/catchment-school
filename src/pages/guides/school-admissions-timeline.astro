const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Follow the School Admissions Timeline in England",
  "description": "Step-by-step guide to the school admissions calendar for primary and secondary schools in England, using September 2027 entry as the example.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Confirm your child's year group and school phase",
      "text": "Work out whether your child is applying for primary (Reception) or secondary (Year 7). For September 2027, Reception is for children born between 1 September 2022 and 31 August 2023, and Year 7 is for children born between 1 September 2015 and 31 August 2016."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Find your home council's admissions portal",
      "text": "Applications open in the autumn of the year before your child starts, and the date varies by council. Apply to the council where you live, even if the school you want is in a different council's area."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Submit your application before the national deadline",
      "text": "For September 2027 entry the secondary (Year 7) deadline is 31 October 2026 and the primary (Reception) deadline is 15 January 2027. Late applications are normally dealt with after on-time applications, so apply on time."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Receive your offer on National Offer Day and respond promptly",
      "text": "Secondary offers are made on Monday 1 March 2027 and primary offers on Friday 16 April 2027. Accept or decline by the date in your offer letter, which your council sets. If you do not respond, the offer may be withdrawn."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Appeal or join a waiting list if you did not get a preferred school",
      "text": "If you were refused a preferred school, lodge an appeal by the deadline in your offer letter, which must allow at least 20 school days. Ask to join the waiting list at the same time. The two are separate and you can do both."
    }
  ]
};
