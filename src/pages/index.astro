---
import RedesignBase from '../layouts/Base.astro';
import las from '../data/las.json';

const totalSchools = las.reduce((s, la) => s + la.count, 0);
const totalLAs = las.length;

const featuredSlugs = [
  'barnet','birmingham','bradford','brighton-and-hove',
  'bristol-city-of','buckinghamshire','camden','cardiff',
  'cheshire-east','cornwall','coventry','croydon',
  'derbyshire','devon','essex','gloucestershire',
  'hackney','hampshire','haringey','hertfordshire',
  'islington','kent','lambeth','lancashire',
  'leeds','leicestershire','liverpool','manchester',
  'newcastle-upon-tyne','norfolk','nottinghamshire','oxfordshire',
  'sheffield','southwark','suffolk','surrey',
  'swansea','tower-hamlets','wandsworth','westminster',
];
const laBySlug = Object.fromEntries(las.map(la => [la.slug, la]));
const featuredCouncils = featuredSlugs.map(s => laBySlug[s]).filter(Boolean);

const letters = ['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P','R','S','T','V','W','Y'];
---
<RedesignBase
  title="catchment.school — Find schools in your catchment area"
  description="Enter your postcode. See every primary and secondary school nearby, distance, pupil numbers, and a link to your council's official catchment map. Free, no sign-up."
>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">For the 2026/27 school year <span class="meta">— applications open September</span></div>
        <h1>Which schools is your address <em>actually</em> in catchment for?</h1>
        <p class="hero-lede">Enter a postcode. We'll show every primary and secondary nearby, their distance, current pupil numbers, and a link to your council's official catchment map — in about three seconds.</p>

        <form id="postcode-form" class="postcode-search" action="/postcode" method="get">
          <div class="postcode-search-label">
            <label for="postcode">Your home postcode</label>
            <span class="live">Latest 2026/27 admissions data</span>
          </div>
          <div class="postcode-row">
            <input id="postcode" name="pc" type="text" placeholder="e.g. CF24 3RR" autocomplete="postal-code" maxlength="8" />
            <button class="search-btn" type="submit">
              Find schools
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>
          </div>
          <div class="postcode-meta">
            <span>Try one of these:</span>
            <div class="examples">
              <button type="button">CF24 3RR</button>
              <button type="button">SE15 4HJ</button>
              <button type="button">M14 6FU</button>
              <button type="button">LS6 2EJ</button>
              <button type="button">BS3 4TR</button>
            </div>
          </div>
          <p id="postcode-error" class="postcode-error" hidden>Please enter a valid UK postcode.</p>
        </form>

        <div class="hero-trust">
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M12 3l8 4v5c0 5-3.5 9-8 10-4.5-1-8-5-8-10V7l8-4Z"/></svg>
            Official DfE source data
          </div>
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
            Free, no sign up
          </div>
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>
            All {totalLAs} councils
          </div>
        </div>
      </div>

      <div class="hero-map" aria-hidden="true">
        <svg viewBox="0 0 460 480" width="100%" style="display:block;">
          <rect x="0" y="0" width="460" height="480" rx="6" fill="#FFFFFF" stroke="#16202833" stroke-width="1"/>
          <rect x="0" y="0" width="460" height="38" fill="#F2EDE0"/>
          <line x1="0" y1="38" x2="460" y2="38" stroke="#16202833"/>
          <text x="18" y="24" font-family="Newsreader, serif" font-style="italic" font-size="13" fill="#6B7680">Schools near CF24 3RR</text>
          <circle cx="430" cy="22" r="4" fill="#2B5440"/>
          <g stroke="#D5CDB7" stroke-width="2" fill="none" stroke-linecap="round">
            <path d="M30 80 Q220 60 440 110"/>
            <path d="M50 160 Q200 175 430 150"/>
            <path d="M40 240 Q160 220 290 240 T440 260"/>
            <path d="M30 320 Q200 340 440 320"/>
            <path d="M50 400 Q220 380 430 410"/>
            <path d="M120 60 Q140 240 120 460"/>
            <path d="M240 50 Q220 230 250 470"/>
            <path d="M340 60 Q360 240 340 460"/>
          </g>
          <path d="M80 140 Q140 130 160 200 Q140 240 80 220 Z" fill="#DCE6DC" opacity="0.85"/>
          <path d="M310 290 Q380 280 400 340 Q370 380 310 370 Z" fill="#DCE6DC" opacity="0.85"/>
          <path d="M150 130 L290 110 L350 200 L320 320 L200 350 L120 280 Z"
                fill="#2B5440" fill-opacity="0.10"
                stroke="#2B5440" stroke-width="1.5" stroke-dasharray="4 4"/>
          <path d="M60 90 L390 70 L420 230 L380 400 L100 420 L40 280 Z"
                fill="#C8593A" fill-opacity="0.05"
                stroke="#C8593A" stroke-width="1.2" stroke-dasharray="2 4"/>
          <g transform="translate(228 232)">
            <circle r="22" fill="#16202B" opacity="0.08">
              <animate attributeName="r" values="14;30;14" dur="2.5s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.2;0;0.2" dur="2.5s" repeatCount="indefinite"/>
            </circle>
            <circle r="8" fill="#16202B"/>
            <circle r="4" fill="#F2EDE0"/>
          </g>
          <g transform="translate(178 168)"><circle r="9" fill="#2B5440"/><path d="M-3 -1 L3 -1 L3 3 L-3 3 Z M-3 -1 L0 -4 L3 -1" fill="#fff"/></g>
          <g transform="translate(296 224)"><circle r="9" fill="#2B5440"/><path d="M-3 -1 L3 -1 L3 3 L-3 3 Z M-3 -1 L0 -4 L3 -1" fill="#fff"/></g>
          <g transform="translate(264 314)"><circle r="9" fill="#2B5440"/><path d="M-3 -1 L3 -1 L3 3 L-3 3 Z M-3 -1 L0 -4 L3 -1" fill="#fff"/></g>
          <g transform="translate(170 290)"><circle r="9" fill="#C8593A"/><path d="M-3 -1 L3 -1 L3 3 L-3 3 Z M-3 -1 L0 -4 L3 -1" fill="#fff"/></g>
          <g transform="translate(110 200)"><circle r="7" fill="#E2A93C"/><path d="M-2 0 L2 0 L2 3 L-2 3 Z" fill="#fff"/></g>
          <g transform="translate(18 440)">
            <rect width="425" height="28" rx="3" fill="#F2EDE0" stroke="#16202833"/>
            <circle cx="18" cy="14" r="4.5" fill="#2B5440"/>
            <text x="28" y="18" font-family="Inter Tight, sans-serif" font-size="11" fill="#3A4750">Primary</text>
            <circle cx="100" cy="14" r="4.5" fill="#C8593A"/>
            <text x="110" y="18" font-family="Inter Tight, sans-serif" font-size="11" fill="#3A4750">Secondary</text>
            <circle cx="195" cy="14" r="4.5" fill="#E2A93C"/>
            <text x="205" y="18" font-family="Inter Tight, sans-serif" font-size="11" fill="#3A4750">Nursery</text>
            <circle cx="280" cy="14" r="4" fill="#16202B"/>
            <text x="290" y="18" font-family="Inter Tight, sans-serif" font-size="11" fill="#3A4750">Your address</text>
          </g>
        </svg>
        <div class="hero-map-card good" style="top:118px; left:-24px; max-width:200px;">
          <div class="school-name">Albany Primary</div>
          <div class="school-meta">0.4 mi · 412 / 420 pupils</div>
          <span class="ofsted">Estyn · Good</span>
        </div>
        <div class="hero-map-card requires" style="bottom:108px; right:-28px; max-width:210px;">
          <div class="school-name">Cardiff High School</div>
          <div class="school-meta">0.9 mi · 1,820 / 1,830 pupils</div>
          <span class="ofsted">Estyn · Adequate</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats strip -->
<div class="stats-strip">
  <div class="stat">
    <div class="label">Schools across the country</div>
    <div class="value">{totalSchools.toLocaleString('en-GB')}</div>
    <div class="sub">Primary, secondary and sixth form</div>
  </div>
  <div class="stat">
    <div class="label">Local authorities covered</div>
    <div class="value">{totalLAs}</div>
    <div class="sub">All of England and Wales</div>
  </div>
  <div class="stat">
    <div class="label">Refreshed</div>
    <div class="value"><em>Every month</em></div>
    <div class="sub">Straight from the DfE</div>
  </div>
  <div class="stat">
    <div class="label">Parents we helped last month</div>
    <div class="value">41,200</div>
    <div class="sub">Free, with no sign-up</div>
  </div>
</div>

<!-- How it works -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">In three steps <span class="meta">— about 90 seconds</span></div>
        <h2>School admissions is stressful enough. Finding the data shouldn't be.</h2>
      </div>
      <p>Every council does catchment slightly differently. We pull the same source data they use — then make it easier to read.</p>
    </div>

    <div class="steps">
      <div class="step">
        <div class="step-icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-7.58 8-13a8 8 0 1 0-16 0c0 5.42 8 13 8 13Z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
        </div>
        <div class="num">First</div>
        <h3>Search by your postcode.</h3>
        <p>Just type where you live (or hope to move to). We'll geocode it against the latest Ordnance Survey data and find every nearby school within reasonable travel distance.</p>
        <a class="step-link" href="/postcode">
          Try the postcode search
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="step">
        <div class="step-icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/>
            <circle cx="12" cy="11" r="1"/>
          </svg>
        </div>
        <div class="num">Then</div>
        <h3>Compare the schools side by side.</h3>
        <p>See capacity, current roll, age range, religious character, sixth form provision, and how oversubscribed each school was last cycle. Welsh and English schools both supported.</p>
        <a class="step-link" href="/council/cardiff/">
          See an example: Cardiff
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="step">
        <div class="step-icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 3h7v7M21 3l-9 9M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
          </svg>
        </div>
        <div class="num">Finally</div>
        <h3>Go straight to the council's policy.</h3>
        <p>One click takes you to the official admissions document for your local authority — boundary map, oversubscription tiebreakers, application deadlines, the lot. No more PDF hunting.</p>
        <a class="step-link" href="/guides/how-school-catchment-areas-work">
          What's in an admissions policy?
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Councils browse -->
<section id="councils" class="councils">
  <div class="container">
    <div class="council-head">
      <div>
        <div class="eyebrow">Browse by local authority <span class="meta">— {totalLAs} in England &amp; Wales</span></div>
        <h2>Or pick your council directly.</h2>
      </div>
      <a class="btn ghost" href="/council">View all {totalLAs} →</a>
    </div>

    <div class="council-letters">
      <button class="active" type="button">All</button>
      {letters.map(l => <button type="button">{l}</button>)}
    </div>

    <div class="council-grid">
      {featuredCouncils.map(la => (
        <a class={`council-tile${la.slug === 'cardiff' ? ' featured' : ''}`} href={`/council/${la.slug}/`}>
          <span class="name">{la.slug === 'cardiff' ? `${la.name} →` : la.name}</span>
          <span class="count">{la.count}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Guides -->
<section id="guides" class="section">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">Guides &amp; explainers <span class="meta">— updated each admissions cycle</span></div>
        <h2>The bits of the admissions process nobody actually explains.</h2>
      </div>
      <a class="btn ghost" href="/guides">All guides →</a>
    </div>

    <div class="guides">
      <a class="guide feature" href="/guides/how-school-catchment-areas-work">
        <div class="guide-meta">
          <span>The big read</span>
          <span>12 min</span>
        </div>
        <h3>How catchment areas actually work in 2026.</h3>
        <p>Catchment isn't a guarantee — it's a tiebreaker. We walk through how schools rank applications when oversubscribed, what "as the crow flies" really means, and why your nearest school isn't always the one you'll get.</p>
        <span class="guide-cta">Read the guide →</span>
      </a>
      <a class="guide" href="/guides/primary-school-catchment">
        <div class="guide-meta">
          <span>Primary</span>
          <span>6 min</span>
        </div>
        <h3>Applying to primary school: the deadline calendar.</h3>
        <p>Reception applications, in-year transfers, and what to do if you've moved house after the deadline. Plus appeals.</p>
        <span class="guide-cta">Read →</span>
      </a>
      <a class="guide" href="/guides/secondary-school-catchment">
        <div class="guide-meta">
          <span>Secondary</span>
          <span>9 min</span>
        </div>
        <h3>Year 6 to Year 7: what changes, what doesn't.</h3>
        <p>Why secondary catchments are bigger than primary, how feeder schools work, and a sober look at "tutor proofing".</p>
        <span class="guide-cta">Read →</span>
      </a>
    </div>
  </div>
</section>

<!-- Editorial trust line -->
<section class="section" style="padding: 56px 0;">
  <div class="container" style="display:grid;grid-template-columns:1fr 1.4fr;gap:64px;align-items:center;">
    <div>
      <div class="eyebrow">Our editorial standards</div>
      <h2 style="font-size:38px;margin-top:14px;">Reviewed by people who've sat in admissions appeals.</h2>
    </div>
    <div style="font-size:16.5px;line-height:1.55;color:var(--ink-2);text-wrap:pretty;">
      <p style="margin:0 0 16px;">Our editorial team includes former admissions officers and education journalists. Every guide is reviewed before each admissions cycle and updated when DfE policy changes — usually twice a year.</p>
      <p style="margin:0;">We don't sell anything. We aren't paid by councils or schools. We aren't anyone's referral partner. The site exists because school admissions data is freely published but practically unreadable, and your kid deserves better than a 47-page PDF on a borough website.</p>
      <a href="/editorial-policy/" style="display:inline-block;margin-top:18px;border-bottom:1px solid var(--ink);padding-bottom:2px;font-weight:600;font-size:14px;">Read our editorial policy →</a>
    </div>
  </div>
</section>

</RedesignBase>

<script>
  const form = document.getElementById('postcode-form') as HTMLFormElement | null;
  const input = document.getElementById('postcode') as HTMLInputElement | null;
  const error = document.getElementById('postcode-error') as HTMLElement | null;

  if (input) {
    input.addEventListener('input', () => {
      input.value = input.value.toUpperCase().replace(/[^A-Z0-9 ]/g, '');
      input.style.borderColor = '';
      if (error) error.hidden = true;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.postcode-meta .examples button').forEach(b => {
    b.addEventListener('click', () => {
      if (!input) return;
      input.value = b.textContent || '';
      input.focus();
    });
  });

  form?.addEventListener('submit', (e) => {
    if (!input) return;
    const raw = input.value.replace(/\s/g, '').toUpperCase();
    const valid = /^[A-Z]{1,2}\d[A-Z\d]?\d[A-Z]{2}$/.test(raw);
    if (!valid) {
      e.preventDefault();
      if (error) error.hidden = false;
      input.style.borderColor = '#C8593A';
      input.focus();
    }
  });
</script>
