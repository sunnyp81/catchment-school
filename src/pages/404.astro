---
export const prerender = true;
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | catchment.school" description="That page could not be found." robots="noindex, follow">
  <h1 class="text-3xl font-bold mb-3">We could not find that page</h1>
  <p class="text-gray-700 mb-3">The link may be out of date, or the two schools in a comparison may not be a valid match. A comparison needs two different schools: both primary, or both secondary or all-through.</p>
  <p class="text-gray-700">
    <a href="/postcode/" class="text-indigo-700 underline">Search schools by postcode</a>
    or <a href="/" class="text-indigo-700 underline">go to the home page</a>.
  </p>
</Base>
