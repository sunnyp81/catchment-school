---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import SchoolDataSections from '../../components/SchoolDataSections.astro';
import admissionsUrls from '../../data/admissions-urls.json';
import topBingSchools from '../../data/top-bing-schools.json';
import { env } from 'cloudflare:workers';
import { notFoundResponse } from '../../lib/notfound';
import { curatedPartners, haversineMiles as cmpMiles } from '../../lib/compare';
import { hasArea } from '../../lib/areas';
import { loadSchoolData, ofstedView, longDate, admissionsByEntry } from '../../lib/schooldata';
import { schoolNoun, admissionsMode, articleFor, titleCase } from '../../lib/schoolwording';
import titleTest from '../../data/title-test-cohort.json';
import { SOURCE_LINE } from '../../lib/oversub-source';

const { slug } = Astro.params;

if (!env?.DB) {
  return new Response('Service unavailable', { status: 503 });
}

const s = await env.DB.prepare('SELECT * FROM schools WHERE slug = ?').bind(slug).first();

if (!s) {
  return notFoundResponse(Astro.url);
}

// D1 still holds the pre-cleanup data, where ageRange uses en-dashes that the Workers
// runtime can corrupt to U+FFFD on output. Sanitise displayed string fields to ASCII
// hyphens at render time so SSR pages match the cleaned static data (no D1 re-import needed).
const deDash = (v: any) => typeof v === 'string' ? v.replace(/[–—�]/g, '-') : v;
for (const k of ['ageRange', 'name', 'town', 'la', 'street', 'locality', 'type']) {
  if (s[k] != null) s[k] = deDash(s[k]);
}

// Readable establishment wording. GIAS phase is "Not applicable" for independent, special, PRU and Welsh records.
const noun = schoolNoun(s);
const admMode = admissionsMode(s);
const councilAdmits = admMode === 'council';
const isIndependent = admMode === 'independent';
const isPlaced = admMode === 'placed';
const isSixteenPlus = admMode === 'other' && String(s.phase ?? '').trim().toLowerCase() === '16 plus';
const isPru = /pupil referral|alternative provision/i.test(String(s.type ?? ''));
const sameKindCol = noun.fromPhase ? 'phase' : 'type';
const sameKindVal = noun.fromPhase ? s.phase : s.type;

// Ofsted, admissions, destinations and school facts come from D1 tables (one batch). Ofsted fields are mapped back onto s.
const schoolData = (await loadSchoolData(env.DB, [String(s.urn)]))[String(s.urn)];
const ofv = ofstedView(schoolData.ofsted, String(s.urn));
if (schoolData.ofsted?.rating) {
  s.ofstedRating = schoolData.ofsted.rating;
  s.ofstedDate = schoolData.ofsted.rdate;
}

const nearby = (await env.DB
  .prepare(`SELECT slug, name, type, postcode FROM schools WHERE town = ? AND laSlug = ? AND ${sameKindCol} = ? AND urn != ? LIMIT 6`)
  .bind(s.town, s.laSlug, sameKindVal, s.urn)
  .all()
).results;

// CHECK-04 (rebuild design): contextual links between faith schools sharing the same
// religious character within the same council - not surfaced by the town-based nearby
// query above, since faith schools of the same denomination are often spread across towns.
const isFaithSchool = !!(s.religion && s.religion !== 'Does not apply' && s.religion !== 'None');
const sameFaithNearby = isFaithSchool
  ? (await env.DB
      .prepare('SELECT slug, name, type, town FROM schools WHERE laSlug = ? AND religion = ? AND urn != ? LIMIT 4')
      .bind(s.laSlug, s.religion, s.urn)
      .all()
    ).results
  : [];

// CHECK-04 (rebuild design): the town-based "nearby" query above is a categorical match,
// not a genuine adjacency link - two schools in the same large town can be miles apart,
// and schools near a town/council boundary get few or no links. This computes real
// straight-line distance from lat/lng (100% populated in D1) so every one of the 26,506
// school pages gets a distance-derived cross-link, not just the ~27% that are faith schools.
function haversineMiles(lat1: number, lng1: number, lat2: number, lng2: number) {
  const toRad = (d: number) => (d * Math.PI) / 180;
  const R = 3958.8; // Earth radius, miles
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

const linkedSlugs = new Set([...nearby, ...sameFaithNearby].map((n: any) => n.slug));
let nearestByDistance: any[] = [];
if (s.lat && s.lng) {
  const latDelta = 0.15; // ~10 miles north-south
  const lngDelta = Math.min(0.4, 0.15 / Math.cos((s.lat * Math.PI) / 180)); // widen with latitude
  const distCandidates = (await env.DB
    .prepare(`SELECT slug, name, type, town, la, laSlug, lat, lng FROM schools WHERE ${sameKindCol} = ? AND lat BETWEEN ? AND ? AND lng BETWEEN ? AND ? AND urn != ? LIMIT 80`)
    .bind(sameKindVal, s.lat - latDelta, s.lat + latDelta, s.lng - lngDelta, s.lng + lngDelta, s.urn)
    .all()
  ).results;
  nearestByDistance = distCandidates
    .filter((c: any) => c.lat != null && c.lng != null && !linkedSlugs.has(c.slug))
    .map((c: any) => ({ ...c, distanceMiles: haversineMiles(s.lat, s.lng, c.lat, c.lng) }))
    .sort((a: any, b: any) => a.distanceMiles - b.distanceMiles)
    .slice(0, 3);
}

// Compare block: ONLY this school's curated pairs (0-3 links, hidden when none).
const comparePartnerUrns = curatedPartners(s.urn);
const comparePartners = comparePartnerUrns.length
  ? (await env.DB
      .prepare(`SELECT slug, name, town, urn, lat, lng FROM schools WHERE urn IN (${comparePartnerUrns.map(() => '?').join(',')})`)
      .bind(...comparePartnerUrns)
      .all()
    ).results.map((p: any) => ({
      name: deDash(p.name),
      town: p.town,
      miles: s.lat != null && p.lat != null ? cmpMiles(s.lat, s.lng, p.lat, p.lng) : null,
      href: `/compare/${Number(s.urn) <= Number(p.urn) ? `${s.slug}-vs-${p.slug}` : `${p.slug}-vs-${s.slug}`}/`,
    })).sort((x: any, y: any) => (x.miles ?? 99) - (y.miles ?? 99)).slice(0, 3)
  : [];

const address = [s.street, s.locality, s.town, s.postcode].filter(Boolean).join(', ');
const directionsUrl = s.lat && s.lng ? `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}` : null;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.name + ' ' + s.postcode)}`;
const councilAdmissionsUrl = `https://www.google.com/search?q=${encodeURIComponent(s.la + ' school admissions catchment area ' + new Date().getFullYear())}`;

// Oversubscription comes only from DfE first preferences against offers. GIAS capacity is not a published admission number.
const admGroups = admissionsByEntry(schoolData.adm)
  .map((g) => ({ ...g, latest: g.rows[g.rows.length - 1] }))
  .filter((g) => g.latest.first_pref != null && g.latest.offers_total != null && Number.isFinite(Number(g.latest.first_pref)) && Number.isFinite(Number(g.latest.offers_total)));
const dfeRow = admGroups[0]?.latest ?? null;
const dfeLabel = admGroups[0]?.label ?? '';
const isOversubscribed = !!dfeRow && Number(dfeRow.first_pref) > Number(dfeRow.offers_total);
const fillRate = s.capacity && s.pupils ? Math.round((s.pupils / s.capacity) * 100) : null;
const admissionsYear = new Date().getFullYear() + 1;

// Verified admissions-authority URLs (each checked live before commit) live in
// src/data/admissions-urls.json, shared with the council template. Used for the "official"
// citation label; councils without a verified URL fall back to an admissions search link.
const pilotAdmissionsUrl = (admissionsUrls as Record<string, string>)[s.laSlug] ?? null;
// Citation URL for the capacity/demand section: prefer a verified council URL, fall back
// to the council admissions search so every school page carries a named source pointer.
const admissionsCiteUrl = pilotAdmissionsUrl ?? councilAdmissionsUrl;
const admissionsCiteVerified = pilotAdmissionsUrl !== null;

// Pilot: data-derived H2 for the capacity/demand section - unique per school.
const pilotCapacityH2 = fillRate !== null
  ? `${s.name}: ${s.pupils} pupils on roll, capacity ${s.capacity}`
  : `${s.name}: admissions capacity`;

// Pilot: FSM context sentence - turns a raw number into a prose signal about the school's community.
// Two sentences where appropriate (task fix-e): split FSM figure from community context.
const pilotFsmProse = councilAdmits && s.fsm != null
  ? `${s.fsm}% of pupils at ${s.name} are recorded as eligible for free school meals in the GIAS register.`
  : null;

// Pilot: fill-rate narrative paragraph - unique per school because fillRate, capacity, and pupils differ.
// fix-a: reorder "X pupils were enrolled in the most recent data" (not "In the most recent data, X pupils were enrolled")
// fix-b: "The school is at or above its published limit of {capacity} places."
// fix-c: "The last-distance figure is likely to remain tight if demand holds at this level."
// fix-d: "{Council} allocates places using ranked criteria: looked-after children first, then siblings, then catchment distance."
// fix-i: no em/en dashes in pilot prose
const rollVsCapacity = fillRate !== null
  ? `${s.name} has <strong>${s.pupils} pupils on roll</strong> compared with a capacity of <strong>${s.capacity} places</strong> in the GIAS register, which is <strong>${fillRate}%</strong> of capacity. GIAS capacity is not a published admission number, and pupils on roll are not the same as places offered in a given year.`
  : null;
const pilotDemandProse = fillRate !== null && !councilAdmits
  ? `${rollVsCapacity} ${isIndependent ? 'Admissions are handled by the school itself, so ask the school about places and entry.' : isPlaced ? `Places are arranged by placement through ${s.la} rather than by application and catchment area.` : 'Ask the establishment directly about places and how to apply.'}`
  : fillRate !== null
  ? `${rollVsCapacity} ${dfeRow ? `The DfE offer day figures show whether the school was oversubscribed on first preferences. Ask ${s.la} for the admissions criteria and any distance data.` : `This page has no DfE offer day figures for the school, so it cannot say whether the school was oversubscribed. Ask ${s.la} for the admissions criteria and any distance data.`}`
  : null;

const introFacts = [
  s.ageRange ? `serving pupils aged ${s.ageRange}` : null,
  s.pupils ? `with ${s.pupils} pupils` : null,
  s.capacity ? `and a capacity of ${s.capacity} places` : null,
].filter(Boolean).join(', ');

// schoolOne / schoolMany: "primary school" / "independent schools" etc, never the raw "Not applicable".
const schoolOne = noun.one;
const schoolMany = noun.many;
const phaseLower = noun.fromPhase ? String(s.phase).toLowerCase() : '';
const typeDesc = noun.fromPhase ? String(s.type ?? '').toLowerCase().replace('school', '').trim() : '';
const introPhrase = `${typeDesc ? `${typeDesc} ` : ''}${schoolOne}`;
const introArticle = articleFor(introPhrase);
const schoolArticle = articleFor(schoolOne);

// Dedup town and council names when they match (e.g. unitary authorities like Derby, Manchester,
// Liverpool, Newcastle, Leeds, Bristol, Sheffield, Coventry, Nottingham, Leicester, Plymouth,
// Stoke, Sunderland, Wolverhampton). Without this guard, copy and breadcrumbs render "Derby, Derby".
const townLaSame = s.town && s.la &&
  s.town.toString().trim().toLowerCase() === s.la.toString().trim().toLowerCase();
const locationLine = townLaSame ? s.town : (s.town && s.la ? `${s.town}, ${s.la}` : (s.town || s.la || ''));

// Ofsted rating
const ofstedLabels: Record<string, string> = {
  '1': 'Outstanding', '2': 'Good', '3': 'Requires improvement', '4': 'Inadequate',
};
const ofstedColors: Record<string, string> = {
  '1': 'bg-green-100 text-green-800 border-green-300',
  '2': 'bg-blue-100 text-blue-800 border-blue-300',
  '3': 'bg-amber-100 text-amber-800 border-amber-300',
  '4': 'bg-red-100 text-red-800 border-red-300',
};
const ofstedLabel = s.ofstedRating ? (ofstedLabels[s.ofstedRating] ?? null) : null;
const ofstedColor = s.ofstedRating ? (ofstedColors[s.ofstedRating] ?? '') : '';
const ofstedYear = s.ofstedDate ? s.ofstedDate.split('/').pop() : null;
// One Ofsted answer for the visible FAQ and the FAQ schema. Leads with a report card when it is newer than the overall grade.
const ofstedFaqText = !ofstedLabel ? null
  : ofv?.cardLater && ofv.card
    ? `The latest Ofsted inspection of ${s.name} was a report card on ${longDate(ofv.card.date)}. Report cards grade separate areas and give no overall grade. The last overall grade was ${ofstedLabel}${ofstedYear ? ` in ${ofstedYear}` : ''}${ofv.predecessor ? ', awarded to a predecessor school on this site' : ''}.`
    : `${s.name} was rated ${ofstedLabel} by Ofsted${ofstedYear ? ` in ${ofstedYear}` : ''}${ofv?.predecessor ? '. That grade was awarded to a predecessor school on this site, for example before academy conversion' : ''}.${ofv?.ungraded ? ` The latest ungraded inspection, on ${longDate(ofv.ungraded.date)}, reported "${ofv.ungraded.outcome}".` : ''}`;
const ofstedReportUrl = ofv?.reportUrl ?? `https://reports.ofsted.gov.uk/search?q=${s.urn}`;

// Catchment guidance - varies by phase, type, and capacity to avoid boilerplate
const isGrammar = s.admissionsPolicy === 'Selective';
const isFaith = s.religion && s.religion !== 'Does not apply' && s.religion !== 'None';
const isAcademy = s.type?.toLowerCase().includes('academy');
const isSpecial = isPlaced && !isPru;

const selectiveNote = isGrammar ? ` The school's admissions policy is listed as selective, so entry may depend on an entrance assessment.` : '';
const catchmentPara1 = isIndependent
  ? `<strong>${s.name}</strong> is an independent school, so ${s.la} does not set its admissions and there is no council catchment area. The school decides who is offered a place.${selectiveNote}${/special/i.test(String(s.type)) ? ` Where a local authority names the school in a child's Education, Health and Care Plan (EHCP), placement is arranged through that authority.` : ''}`
  : isPru
  ? `Places at <strong>${s.name}</strong> are arranged by placement, usually through <strong>${s.la}</strong> or the child's current school, rather than through the main admissions round. There is no catchment area in the mainstream sense.`
  : admMode === 'other'
  ? (isSixteenPlus ? `<strong>${s.name}</strong> is a 16 plus provider, not a school with a council catchment area. The provider sets its own admissions, so contact it directly about courses, entry requirements and how to apply.` : `<strong>${s.name}</strong> is not a mainstream school, so the usual council catchment area process does not apply. Contact the establishment directly about how to apply.`)
  : isGrammar
  ? `Entry to <strong>${s.name}</strong> is selective, and applicants must pass the relevant admissions test. Among qualifying applicants, <strong>${s.la}</strong> may use distance or catchment area as a tiebreaker when the school is oversubscribed. Check the admissions policy for how the selection and distance criteria interact.`
  : isSpecial
  ? `Admission to <strong>${s.name}</strong> follows a different process from mainstream schools. <strong>${s.la}</strong> assesses each child's Education, Health and Care Plan (EHCP) to determine appropriate placement. Catchment area does not apply in the same way as mainstream admissions.`
  : isFaith
  ? `Admission to <strong>${s.name}</strong> is managed by <strong>${s.la}</strong> and typically includes both faith criteria and catchment area proximity. The weighting given to each criterion depends on the school's published oversubscription policy, which is reviewed annually.`
  : isAcademy
  ? `As an academy, <strong>${s.name}</strong> sets its own admissions criteria, agreed with <strong>${s.la}</strong>. The catchment area boundary is defined in the school's annual admissions policy, which may differ from the LA's general school admissions arrangements.`
  : s.phase === 'Secondary'
  ? `Secondary school places at <strong>${s.name}</strong> are allocated by <strong>${s.la}</strong> using ranked oversubscription criteria. Catchment area residence is typically among the highest priorities after looked-after children and siblings, and the boundary is reviewed each year.`
  : `Where <strong>${s.name}</strong> uses a catchment area, it is set out in the admissions policy published by <strong>${s.la}</strong>. Not every school uses one, so check the policy for how places are ranked when applications exceed the number of available places.`;

const catchmentPara2 = isIndependent
  ? `Contact the school directly about how to apply, entry requirements and any assessment dates.`
  : isPru
  ? `Ask ${s.la} how placements into alternative provision work and which provision is available.`
  : admMode === 'other'
  ? `Check the establishment's own website or the DfE Get Information About Schools record for current details.`
  : isGrammar
  ? `The full admissions policy, including test registration dates, qualifying scores, and any distance criteria, is published by ${s.la} before each admissions cycle. Verify your child's eligibility and your home address directly with the council.`
  : isSpecial
  ? `For more information on how ${s.la} assesses EHCP placements and which schools are named, contact the council's SEND team directly. The council must publish its Local Offer explaining available provision.`
  : `The official admissions policy, including any catchment area or distance details, is published by ${s.la} before each admissions cycle. Always verify your address with the council before submitting an application.`;

// Extractable definitional answer (AEO/GEO): self-contained, data-derived, cite-ready.
const catchmentAnswer = isIndependent
  ? `${s.name} does not have a council catchment area. It is an independent school, so ${s.la} does not set its admissions: the school decides who is offered a place. Contact the school for its entry requirements and how to apply.`
  : isPru
  ? `${s.name} does not use a catchment area. Places are arranged by placement, usually through ${s.la} or the child's current school, rather than through the main admissions round.`
  : admMode === 'other'
  ? (isSixteenPlus ? `${s.name} is a 16 plus provider and does not use a council catchment area. The provider sets its own admissions, so contact it directly about courses, entry requirements and how to apply.` : `${s.name} is not a mainstream school, so the usual council catchment area process does not apply. Contact the establishment directly about how to apply.`)
  : isSpecial
  ? `${s.name} is ${schoolArticle} ${schoolOne} in ${locationLine}, and it does not use a standard catchment area. ${s.la} allocates places through each child's Education, Health and Care Plan (EHCP) rather than home-to-school distance, so placement depends on assessed need rather than a geographic boundary.`
  : `${s.name} is ${schoolArticle} ${schoolOne} in ${locationLine}. Where a school has a catchment area, children living inside it are usually ranked higher when the school has more applications than places, ${isGrammar ? `though entry first depends on passing the selective admissions test` : isFaith ? `after looked-after children and, in most years, faith-based criteria` : `after looked-after children and siblings`}. Many councils publish distance data, but not every school uses a catchment area. ${isAcademy || isFaith || /foundation/i.test(String(s.type)) ? `${isFaith ? 'As a faith school' : isAcademy ? 'As an academy' : 'As a foundation school'}, ${s.name} may set its own admissions criteria, so check its published admissions policy. ` : ''}${s.la} can confirm the criteria and any boundary or distance figures for this school.`;

// 20-page title and data-lead test (src/data/title-test-cohort.json). Cohort pages need a 2026-27 DfE row to switch; all others keep the standard title.
const cohortAdm = (titleTest.slugs as string[]).includes(String(slug))
  ? admissionsByEntry(schoolData.adm).map((g) => ({ ...g, latest: g.rows[g.rows.length - 1] })).filter((g) => g.latest.year === '2026-27' && g.latest.first_pref != null && g.latest.offers_total != null)
  : [];
const inCohort = cohortAdm.length > 0;
const cohortFirst = cohortAdm[0]?.latest;
const cohortTitle = (() => {
  for (const tail of [': Places, Offers and First Preferences', ': Places and Offers', '']) {
    const t = `${s.name} Admissions 2026${tail}`;
    if (t.length <= 65) return t;
  }
  return `${s.name} Admissions 2026`;
})();
const cohortDescription = inCohort
  ? `${s.name}: ${cohortFirst.first_pref.toLocaleString('en-GB')} first preferences and ${cohortFirst.offers_total.toLocaleString('en-GB')} offers for ${cohortAdm[0].label} entry in ${cohortFirst.year} (DfE offer day figures), plus places, Ofsted and nearby ${schoolMany} in ${locationLine}.`
  : '';

const title = inCohort ? cohortTitle : `${s.name} Catchment Area 2026: Map & Boundary`;
const description = inCohort ? cohortDescription : councilAdmits
  ? `${s.name} catchment area boundary in ${locationLine}. Check if your address is in catchment${ofstedLabel ? `, Ofsted: ${ofstedLabel}` : ''}, admissions policy and nearby ${schoolMany}.`
  : `${s.name} in ${locationLine}: how admissions work${ofstedLabel ? `, Ofsted: ${ofstedLabel}` : ''}, age range and nearby ${schoolMany}.`;

// FAQ answers for establishments whose admissions are not set by the council (null for ordinary council-admitting schools).
const oversubAnswer = dfeRow
  ? `In ${dfeRow.year}, ${s.name} received ${Number(dfeRow.first_pref).toLocaleString('en-GB')} first preferences and made ${Number(dfeRow.offers_total).toLocaleString('en-GB')} offers for ${dfeLabel} entry, so it was ${isOversubscribed ? '' : 'not '}oversubscribed on first preferences (DfE offer day figures; appeals and waiting lists are not counted).`
  : `${s.name} has ${s.pupils ?? 'an unknown number of'} pupils on roll${s.capacity ? ` compared with a capacity of ${s.capacity} places in the GIAS register` : ''}. This page has no DfE offer day figures for the school, so it cannot say whether the school was oversubscribed. Check the latest admissions data with ${s.la}.`;
const faqOversubOverride = councilAdmits ? null
  : `${[s.capacity ? `${s.name} has a capacity of ${s.capacity} places` : null, s.pupils ? `${s.capacity ? 'and currently has' : `${s.name} currently has`} ${s.pupils} pupils enrolled` : null].filter(Boolean).join(' ') || `${s.name} has no capacity or roll figure on record here`}. ${isIndependent ? 'Admissions are set by the school, so ask the school about current availability.' : isPlaced ? `Places are arranged by placement through ${s.la}, so ask them about availability.` : 'Ask the establishment directly about current availability.'}`;
const faqAdmissionsOverride = councilAdmits ? null
  : isIndependent
    ? `${s.name} is an independent school and sets its own admissions.${isGrammar ? ' Its admissions policy is listed as selective.' : ''} Contact the school for entry requirements and how to apply.`
    : isPlaced
      ? `Places at ${s.name} are arranged by placement through ${s.la}${isPru ? '' : ", based on the child's Education, Health and Care Plan (EHCP)"}, not by the main admissions round or catchment area. Ask ${s.la} how this works.`
      : isSixteenPlus
        ? `${s.name} is a 16 plus provider and sets its own admissions. Contact the provider directly about courses, entry requirements and how to apply.`
        : `${s.name} is not a mainstream school, so the usual council admissions process does not apply. Contact the establishment directly about how to apply.`;

const schoolSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": s.name,
  "description": `${s.name} is ${schoolArticle} ${schoolOne} in ${locationLine}, England.`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": [s.street, s.locality].filter(Boolean).join(', '),
    "addressLocality": s.town,
    "postalCode": s.postcode,
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": s.lat,
    "longitude": s.lng
  },
  ...(s.website ? { "url": s.website.startsWith('http') ? s.website : 'https://' + s.website } : {}),
  ...(s.pupils ? { "numberOfStudents": s.pupils } : {}),
  "sameAs": [
    `https://get-information-about-schools.service.gov.uk/Establishments/Establishment/Details/${s.urn}`,
    ofstedReportUrl
  ],
};

// FAQ schema - school-specific questions for featured snippet eligibility
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the catchment area for ${s.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": catchmentAnswer
      }
    },
    {
      "@type": "Question",
      "name": `Is ${s.name} oversubscribed?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faqOversubOverride ?? oversubAnswer
      }
    },
    {
      "@type": "Question",
      "name": `What is the admissions policy for ${s.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faqAdmissionsOverride ?? (isGrammar
          ? `${s.name} is a selective school: admission requires passing the relevant admissions test. ${s.la} publishes the full policy including test dates, qualifying scores and any distance tiebreaker each year.`
          : isFaith
            ? `${s.name} uses both faith criteria and catchment area proximity in its admissions policy. The weighting varies each year and is published by ${s.la} before each admissions cycle.`
            : `Admission to ${s.name} is managed by ${s.la}. When oversubscribed, places are allocated using ranked oversubscription criteria, typically looked-after children first, then siblings, then catchment area distance. Always verify with the council before applying.`)
      }
    },
    {
      "@type": "Question",
      "name": `What age range does ${s.name} cover?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": s.ageRange
          ? `${s.name} is ${schoolArticle} ${schoolOne} serving pupils aged ${s.ageRange} in ${locationLine}.`
          : `${s.name} is ${schoolArticle} ${schoolOne} in ${locationLine}. Check the school's website or the DfE GIAS service for the current age range.`
      }
    },
    ...(ofstedLabel ? [{
      "@type": "Question",
      "name": `What is the Ofsted rating for ${s.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${ofstedFaqText} Full inspection reports are available on the Ofsted website at reports.ofsted.gov.uk.`
      }
    }] : []),
  ]
};

const breadcrumbItems: Array<{"@type": "ListItem", position: number, name: string, item: string}> = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://catchment.school/" },
  { "@type": "ListItem", "position": 2, "name": s.la, "item": `https://catchment.school/council/${s.laSlug}` },
];
if (s.town && !townLaSame && hasArea(s.townSlug)) {
  breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": s.town, "item": `https://catchment.school/area/${s.townSlug}` });
}
breadcrumbItems.push({
  "@type": "ListItem",
  "position": breadcrumbItems.length + 1,
  "name": `${s.name} Catchment Area`,
  "item": `https://catchment.school/school/${s.slug}`
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---
<Base title={title} description={description}>
  <Fragment slot="head">
    {isIndependent && <meta name="googlebot" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(schoolSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    {s.lat && s.lng && (
      <>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      </>
    )}
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6 flex gap-2 items-center flex-wrap">
    <a href="/" class="hover:underline">Home</a>
    <span>›</span>
    <a href={`/council/${s.laSlug}/`} class="hover:underline">{s.la}</a>
    {s.town && !townLaSame && hasArea(s.townSlug) && (
      <>
        <span>›</span>
        <a href={`/area/${s.townSlug}/`} class="hover:underline">{s.town}</a>
      </>
    )}
    <span>›</span>
    <span class="text-gray-700 truncate max-w-xs">{s.name}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">

      <h1 class="text-3xl font-bold mb-2">{inCohort ? `${s.name} Admissions 2026` : `${s.name} Catchment Area`}</h1>

      <AuthorByline type="school" />

      {inCohort && (
        <section class="bg-white border border-gray-200 rounded-lg p-4 mb-6" id="dfe-offers" aria-label={`${s.name} applications and offers`}>
          <h2 class="text-base font-semibold text-gray-900 mb-3">{s.name}: first preferences and offers</h2>
          <div class="space-y-3">
            {cohortAdm.map((g) => (
              <div>
                <p class="text-xs font-medium text-gray-500 mb-1">{g.label} entry, {g.latest.year}</p>
                <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
                  <div><dt class="text-xs text-gray-500">First preferences</dt><dd class="text-lg font-bold text-indigo-700">{g.latest.first_pref.toLocaleString('en-GB')}</dd></div>
                  <div><dt class="text-xs text-gray-500">Offers made</dt><dd class="text-lg font-bold text-indigo-700">{g.latest.offers_total.toLocaleString('en-GB')}</dd></div>
                  {g.latest.first_pref_per_offer != null && <div><dt class="text-xs text-gray-500">First preferences per offer</dt><dd class="text-lg font-bold text-indigo-700">{Number(g.latest.first_pref_per_offer).toFixed(2)}</dd></div>}
                  {g.latest.pct_first_pref_offered != null && <div><dt class="text-xs text-gray-500">First preferences offered a place</dt><dd class="text-lg font-bold text-indigo-700">{Number(g.latest.pct_first_pref_offered).toFixed(1)}%</dd></div>}
                </dl>
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-500 mt-3">{SOURCE_LINE} Offer day figures only: appeals and waiting lists are not counted. DfE does not publish a last distance offered nationally, so ask {s.la} for the distance cut-off.</p>
        </section>
      )}

      <p class="text-gray-600 mb-6">
        {s.name} is {introArticle} {introPhrase} in {locationLine}{introFacts ? `, ${introFacts}` : ''}.
        {!councilAdmits
          ? ` Find admissions guidance and nearby ${schoolMany} below.`
          : isOversubscribed
          ? ` The DfE offer day figures show more first preferences than offers.`
          : ` Find catchment area guidance, admissions policy details and nearby ${schoolMany} below.`
        }
      </p>

      {topBingSchools.includes(slug) && (s.phase === 'Primary' || s.phase === 'Secondary') && (
        <div class="border border-indigo-200 rounded-lg p-4 mb-6 bg-indigo-50 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
          <p class="text-sm text-gray-700"><strong class="text-indigo-900">Need a tutor in {s.town}?</strong> Find {phaseLower} tutors for maths, English, science and more.</p>
          <a
            href={`https://thetutor.link/?ref=catchment&town=${encodeURIComponent(s.town)}`}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="shrink-0 text-center bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-indigo-800 transition-colors"
          >
            Find a tutor near {s.town} →
          </a>
        </div>
      )}

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        {s.ageRange && (
          <div class="bg-indigo-50 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-indigo-700">{s.ageRange}</p>
            <p class="text-xs text-gray-500 mt-1">Age range</p>
          </div>
        )}
        {s.pupils && (
          <div class="bg-indigo-50 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-indigo-700">{s.pupils.toLocaleString()}</p>
            <p class="text-xs text-gray-500 mt-1">Pupils</p>
          </div>
        )}
        {s.capacity && (
          <div class="rounded-lg p-4 text-center bg-indigo-50">
            <p class="text-2xl font-bold text-indigo-700">{s.capacity.toLocaleString()}</p>
            <p class="text-xs text-gray-500 mt-1">Capacity</p>
          </div>
        )}
        {fillRate && (
          <div class="rounded-lg p-4 text-center bg-indigo-50">
            <p class="text-2xl font-bold text-indigo-700">{fillRate}%</p>
            <p class="text-xs text-gray-500 mt-1">Pupils on roll as a share of capacity</p>
          </div>
        )}
        {ofstedLabel && (
          <div class={`rounded-lg p-4 text-center border ${ofstedColor}`}>
            <p class="text-sm font-bold leading-tight">{ofstedLabel}</p>
            <p class="text-xs mt-1 opacity-70">Ofsted{ofstedYear ? ` ${ofstedYear}` : ''}</p>
          </div>
        )}
      </div>

      <section id="catchment-area" class="mb-8">
        <h2 class="text-xl font-semibold mb-3">{s.name} Catchment Area Information</h2>
        <div class="bg-white border-l-4 border-indigo-500 rounded-r-lg p-5 mb-4 shadow-sm">
          <p class="text-sm font-semibold text-gray-500 mb-1">What is the catchment area for {s.name}?</p>
          <p class="text-base text-gray-800 leading-relaxed">{catchmentAnswer}</p>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-5">
          <p class="text-sm text-gray-700 mb-3" set:html={catchmentPara1} />
          {councilAdmits && isOversubscribed && dfeRow && (
            <div class="bg-amber-100 border border-amber-300 rounded p-3 mb-3 text-sm text-amber-800">
              <strong>Oversubscribed on first preferences:</strong> {Number(dfeRow.first_pref).toLocaleString('en-GB')} first preferences for {Number(dfeRow.offers_total).toLocaleString('en-GB')} offers, {dfeLabel} entry, {dfeRow.year} (DfE offer day figures).
              <p class="mt-2">
                Not getting a place? <a href="/guides/how-to-appeal-a-school-place" class="font-semibold text-amber-900 underline hover:no-underline">Learn how to appeal a school place →</a>
              </p>
              <p class="mt-2">
                Want the cut-off distance before you apply? <a href="#alerts" class="font-semibold text-amber-900 underline hover:no-underline">Get an alert when {s.la} publishes the {admissionsYear} {s.name} numbers →</a>
              </p>
            </div>
          )}
          <p class="text-sm text-gray-700 mb-4">{catchmentPara2}</p>
          {councilAdmits && (
          <a
            href={councilAdmissionsUrl}
            target="_blank"
            rel="nofollow noopener"
            class="inline-block bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-indigo-800 transition-colors"
          >
            Find {s.la} catchment area documents →
          </a>
          )}
        </div>
      </section>

      {pilotDemandProse && (
        <section class="mb-8" id="capacity-demand">
          <h2 class="text-xl font-semibold mb-3">{pilotCapacityH2}</h2>
          <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-3 text-sm text-gray-700">
            <p set:html={pilotDemandProse} />
            {/* fix-h: discourse bridge ties FSM to capacity context */}
            {pilotFsmProse && (
              <p>
                The fill-rate figure above reflects overall demand, but the school's intake also varies by community profile.{' '}
                {pilotFsmProse}
              </p>
            )}
            {/* fix-g: postcode tool callout - pilot only */}
            {councilAdmits && (
            <p>
              To check whether your home address falls within the historical catchment boundary, use the{' '}
              <a href="/postcode" class="text-indigo-700 underline hover:no-underline font-medium">postcode search tool</a>{' '}
              on this site.
            </p>
            )}
            {councilAdmits && s.phase !== 'Nursery' && s.phase !== 'Special' && (
              <p>
                {s.la} publishes its full admissions policy, including oversubscription criteria, the previous year's last-distance figures, and the appeals timetable, on the council's official admissions page.{' '}
                <a
                  href={admissionsCiteUrl}
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                  class="text-indigo-700 underline hover:no-underline font-medium"
                >
                  {admissionsCiteVerified ? `${s.la} Council school admissions (official) →` : `Find ${s.la} school admissions →`}
                </a>
              </p>
            )}
          </div>
        </section>
      )}

      <SchoolDataSections s={s} data={schoolData} />

      <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">{s.name}: School Information</h2>
        <dl class="divide-y border rounded-lg overflow-hidden">
          {([
            ['Full address', address],
            ['Local authority', s.la],
            ['School type', s.type],
            ['Phase of education', noun.fromPhase ? s.phase : null],
            ['Age range', s.ageRange ? `${s.ageRange} years` : null],
            ['Gender', s.gender && s.gender !== 'Mixed' && s.gender !== 'Not applicable' ? s.gender : null],
            ['Religious character', s.religion && s.religion !== 'Does not apply' && s.religion !== 'None' ? s.religion : null],
            ['Admissions policy', s.admissionsPolicy && s.admissionsPolicy !== 'Not applicable' ? s.admissionsPolicy : null],
            ['Free school meals', s.fsm ? `${s.fsm}% of pupils` : null],
            ['DfE URN', s.urn],
          ] as [string, string | null][]).filter(([, v]) => v).map(([label, value]) => (
            <div class="flex px-4 py-3 text-sm">
              <dt class="w-48 font-medium text-gray-500 shrink-0">{label}</dt>
              <dd class="text-gray-900">{value}</dd>
            </div>
          ))}
        </dl>
      </section>

      {nearby.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Other {titleCase(schoolMany)} in {s.town}</h2>
          <p class="text-sm text-gray-600 mb-4">
            If {s.name} is oversubscribed, these {schoolMany} in {s.town} are the next closest alternatives.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {nearby.map((n: any) => (
              <a href={`/school/${n.slug}/`} class="block border rounded-lg p-4 hover:border-indigo-400 transition-colors">
                <p class="font-medium text-indigo-700 text-sm hover:underline">{n.name} Catchment Area</p>
                <p class="text-xs text-gray-500 mt-1">{n.type} · {n.postcode}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {sameFaithNearby.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Other {s.religion} Schools in {s.la}</h2>
          <p class="text-sm text-gray-600 mb-4">
            {s.name} shares its religious character with these {s.religion} schools across {s.la}. Faith criteria typically sit alongside catchment distance in each school's admissions policy.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {sameFaithNearby.map((n: any) => (
              <a href={`/school/${n.slug}/`} class="block border rounded-lg p-4 hover:border-indigo-400 transition-colors">
                <p class="font-medium text-indigo-700 text-sm hover:underline">{n.name} Catchment Area</p>
                <p class="text-xs text-gray-500 mt-1">{n.type} · {n.town}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {nearestByDistance.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Nearest {schoolMany} by distance</h2>
          <p class="text-sm text-gray-600 mb-4">
            These are the {schoolMany} closest to {s.name} by straight-line distance, including ones across a town or council boundary. Schools in a different council area name that council. Distance is not the same as being in catchment: always check each school's own admissions policy for its actual boundary.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {nearestByDistance.map((n: any) => (
              <a href={`/school/${n.slug}/`} class="block border rounded-lg p-4 hover:border-indigo-400 transition-colors">
                <p class="font-medium text-indigo-700 text-sm hover:underline">{n.name} Catchment Area</p>
                <p class="text-xs text-gray-500 mt-1">{n.type} · {n.town}{n.laSlug && n.laSlug !== s.laSlug ? `, ${n.la}` : ''} · {n.distanceMiles.toFixed(1)} miles away</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {comparePartners.length > 0 && (
        <section class="mb-8" id="compare">
          <h2 class="text-xl font-semibold mb-4">Compare {s.name} with nearby schools</h2>
          <p class="text-sm text-gray-600 mb-4">
            Side-by-side Ofsted grade, results, attendance, capacity and admissions policy against the closest {schoolMany}.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {comparePartners.map((p: any) => (
              <a href={p.href} class="block border rounded-lg p-4 hover:border-indigo-400 transition-colors">
                <p class="font-medium text-indigo-700 text-sm hover:underline">{s.name} vs {p.name}</p>
                <p class="text-xs text-gray-500 mt-1">{p.town}{p.miles != null ? ` · ${p.miles.toFixed(1)} miles away` : ''}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Parent-hub link mesh - always surfaces council + area links in body copy -->
      <nav class="mb-8 p-4 border border-indigo-100 bg-indigo-50/40 rounded-lg text-sm" aria-label="Related catchment hubs">
        <p class="font-medium text-gray-700 mb-2">Explore nearby catchment areas</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {s.town && hasArea(s.townSlug) && (
            <li>
              <a href={`/area/${s.townSlug}/`} class="text-indigo-700 hover:underline">
                All schools in {s.town} →
              </a>
            </li>
          )}
          <li>
            <a href={`/council/${s.laSlug}/`} class="text-indigo-700 hover:underline">
              {s.la} school catchment areas →
            </a>
          </li>
          <li>
            <a href="/council" class="text-indigo-700 hover:underline">
              All English councils →
            </a>
          </li>
        </ul>
      </nav>

      <div class="border rounded-lg p-5 bg-gray-50 text-sm">
        <p class="font-medium mb-2">Need help understanding catchment areas?</p>
        <div class="flex flex-wrap gap-3">
          <a href="/guides/how-school-catchment-areas-work" class="text-indigo-700 hover:underline">How catchment areas work →</a>
          <a href="/guides/school-admissions-timeline" class="text-indigo-700 hover:underline">Admissions timeline →</a>
          {s.phase === 'Primary' && <a href="/guides/primary-school-catchment" class="text-indigo-700 hover:underline">Primary school guide →</a>}
          {s.phase === 'Secondary' && <a href="/guides/secondary-school-catchment" class="text-indigo-700 hover:underline">Secondary school guide →</a>}
          <a href="/guides/in-year-admissions" class="text-indigo-700 hover:underline">In-year admissions →</a>
          <a href="/guides/school-waiting-lists" class="text-indigo-700 hover:underline">School waiting lists →</a>
          {isGrammar && <a href="/guides/how-to-appeal-a-school-place" class="text-indigo-700 hover:underline">Selective test appeals →</a>}
          {ofstedLabel && <a href="/guides/ofsted-ratings-explained" class="text-indigo-700 hover:underline">Understanding Ofsted ratings →</a>}
        </div>
      </div>

      <!-- FAQ section -->
      <section class="mt-8" id="faq">
        <h2 class="text-xl font-semibold mb-4">Frequently Asked Questions: {s.name}</h2>
        <div class="space-y-4">
          <details class="border rounded-lg p-4 group" open>
            <summary class="font-medium cursor-pointer list-none flex justify-between items-center">
              What is the catchment area for {s.name}?
              <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-sm text-gray-700">{catchmentAnswer}</p>
          </details>
          <details class="border rounded-lg p-4 group">
            <summary class="font-medium cursor-pointer list-none flex justify-between items-center">
              Is {s.name} oversubscribed?
              <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-sm text-gray-700">
              {faqOversubOverride ?? oversubAnswer}
            </p>
          </details>
          <details class="border rounded-lg p-4 group">
            <summary class="font-medium cursor-pointer list-none flex justify-between items-center">
              What is the admissions policy for {s.name}?
              <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-sm text-gray-700">
              {faqAdmissionsOverride ?? (isGrammar
                ? `${s.name} is a selective school: admission requires passing the relevant admissions test. ${s.la} publishes the full policy each year, including test dates, qualifying scores, and any distance tiebreaker.`
                : isFaith
                  ? `${s.name} uses both faith criteria and catchment area proximity in its admissions policy. The weighting is reviewed annually and published by ${s.la} before each admissions cycle.`
                  : `Admission to ${s.name} is managed by ${s.la}. When oversubscribed, places go to looked-after children first, then siblings, then catchment area distance. Always verify the current policy with the council before applying.`)
              }
            </p>
          </details>
          {s.ageRange && (
            <details class="border rounded-lg p-4 group">
              <summary class="font-medium cursor-pointer list-none flex justify-between items-center">
                What age range does {s.name} cover?
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="mt-3 text-sm text-gray-700">
                {s.name} is {schoolArticle} {schoolOne} in {locationLine}, serving pupils aged {s.ageRange}. For the latest information, visit the school's website or the DfE Get Information About Schools service.
              </p>
            </details>
          )}
          {ofstedLabel && (
            <details class="border rounded-lg p-4 group">
              <summary class="font-medium cursor-pointer list-none flex justify-between items-center">
                What is the Ofsted rating for {s.name}?
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="mt-3 text-sm text-gray-700">
                {ofstedFaqText} Full inspection reports are available at <a href={ofstedReportUrl} target="_blank" rel="nofollow noopener" class="text-indigo-700 hover:underline">reports.ofsted.gov.uk</a>.
              </p>
            </details>
          )}
        </div>
      </section>
    </div>

    <aside class="space-y-4">
      <div class="border rounded-lg p-5">
        <h3 class="font-semibold mb-3">Location</h3>
        {s.lat && s.lng && (
          <div id="school-map" class="w-full h-48 rounded-lg mb-3 bg-gray-100"></div>
        )}
        <p class="text-sm text-gray-600 mb-3">{address}</p>
        {directionsUrl && (
          <a href={directionsUrl} target="_blank" rel="nofollow noopener" aria-label={`Get directions to ${s.name} on Google Maps (opens in a new tab)`}
            class="block text-center bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-indigo-800 transition-colors mb-2">
            Get directions
          </a>
        )}
        <a href={mapsUrl} target="_blank" rel="nofollow noopener"
          class="block text-center border border-indigo-200 text-indigo-700 text-sm font-medium px-4 py-2 rounded-lg hover:bg-indigo-50 transition-colors">
          View on Google Maps →
        </a>
      </div>

      {s.website && (
        <div class="border rounded-lg p-5">
          <h3 class="font-semibold mb-2">School Website</h3>
          <a href={s.website.startsWith('http') ? s.website : 'https://' + s.website}
            target="_blank" rel="nofollow noopener"
            class="text-sm text-indigo-700 hover:underline break-all">
            {s.website}
          </a>
        </div>
      )}

      {ofstedLabel && (
        <div class={`border rounded-lg p-5 ${ofstedColor}`}>
          <h3 class="font-semibold mb-1">Ofsted Rating</h3>
          <p class="text-lg font-bold mb-1">{ofstedLabel}</p>
          {ofstedYear && <p class="text-xs opacity-70 mb-1">Graded {ofstedYear}</p>}
          {ofv?.latestDate && ofv.latestDate !== s.ofstedDate && <p class="text-xs opacity-70 mb-1">Latest inspection {longDate(ofv.latestDate)}</p>}
          <a href={ofstedReportUrl}
            target="_blank" rel="nofollow noopener"
            class="block text-sm font-medium hover:underline mt-2">
            Read full Ofsted report →
          </a>
          <a href="/guides/ofsted-ratings-explained"
            class="block text-sm font-medium hover:underline mt-2">
            Understand Ofsted ratings →
          </a>
        </div>
      )}

      <div class="border rounded-lg p-5">
        <h3 class="font-semibold mb-3">Official Data</h3>
        <a href={`https://get-information-about-schools.service.gov.uk/Establishments/Establishment/Details/${s.urn}`}
          target="_blank" rel="nofollow noopener"
          class="block text-sm text-indigo-700 hover:underline mb-2">
          DfE Get Information About Schools →
        </a>
        <a href={ofstedReportUrl}
          target="_blank" rel="nofollow noopener"
          class="block text-sm text-indigo-700 hover:underline">
          Ofsted inspection reports →
        </a>
      </div>

      <div class="border rounded-lg p-5">
        <h3 class="font-semibold mb-3">Browse</h3>
        {s.town && hasArea(s.townSlug) && <a href={`/area/${s.townSlug}/`} class="block text-sm text-indigo-700 hover:underline mb-2">All schools in {s.town} →</a>}
        <a href={`/council/${s.laSlug}/`} class="block text-sm text-indigo-700 hover:underline mb-2">All schools in {s.la} council →</a>
        <a href="/postcode" class="block text-sm text-indigo-700 hover:underline">Search by postcode →</a>
      </div>

      <!-- Email capture -->
      <div id="alerts" class="border-2 border-indigo-200 rounded-lg p-5 bg-indigo-50 scroll-mt-24">
        <h3 class="font-semibold mb-1 text-indigo-900">Admissions updates for {s.name}</h3>
        <p class="text-sm text-gray-600 mb-3">
          Get an email with admissions dates and new admissions data for {s.name}. One email per update, no spam.
        </p>
        <form
          action="https://emailit-worker.sunnypat81.workers.dev/"
          method="POST"
          class="space-y-2"
          id="catchment-email-form"
        >
          <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
          <input type="hidden" name="_site" value="catchment.school" />
          <input type="hidden" name="subject" value={`Catchment update signup: ${s.name}, ${s.la} (catchment.school)`} />
          <input type="hidden" name="school" value={s.name} />
          <input type="hidden" name="town" value={s.town} />
          <input type="hidden" name="la" value={s.la} />
          <input type="hidden" name="phase" value={s.phase} />
          <input type="hidden" name="redirectTo" value={`https://catchment.school/school/${s.slug}?subscribed=1`} />
          <input
            type="email"
            name="email"
            required
            placeholder="Your email address"
            class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"
          />
          <button
            type="submit"
            class="w-full bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-indigo-800 transition-colors"
          >
            Notify me →
          </button>
        </form>
        <p id="subscribed-msg" class="hidden text-sm text-green-700 font-medium mt-2">You're on the list. We'll email you admissions dates and new data for {s.name}.</p>
      </div>

      <!-- Find homes near this school -->
      <div class="border rounded-lg p-5">
        <h3 class="font-semibold mb-2">Find homes near {s.name}</h3>
        <p class="text-sm text-gray-600 mb-3">{councilAdmits ? 'Search for properties within the catchment area on Rightmove.' : `Search for properties near ${s.name} on Rightmove.`}</p>
        <a
          href={`https://www.rightmove.co.uk/property-for-sale/find.html?searchType=SALE&locationIdentifier=POSTCODE%5E${s.postcode?.replace(/\s/g, '')}&radius=0.5&sortType=6`}
          target="_blank"
          rel="nofollow noopener"
          class="block text-center bg-green-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-green-800 transition-colors mb-2"
        >
          Search properties on Rightmove →
        </a>
        <a
          href={`https://www.zoopla.co.uk/for-sale/property/${s.town?.toLowerCase().replace(/\s+/g, '-')}/`}
          target="_blank"
          rel="nofollow noopener"
          class="block text-center border border-green-300 text-green-700 text-sm font-medium px-4 py-2 rounded-lg hover:bg-green-50 transition-colors"
        >
          Search on Zoopla →
        </a>
      </div>

      <!-- TheTutorLink CTA -->
      {(s.phase === 'Primary' || s.phase === 'Secondary') && (
        <div class="border border-indigo-200 rounded-lg p-5 bg-indigo-50">
          <h3 class="font-semibold mb-2 text-indigo-900">Need a tutor in {s.town}?</h3>
          <p class="text-sm text-gray-700 mb-3">
            Find qualified {phaseLower} tutors in {s.town}: maths, English, science and more.
          </p>
          <a
            href={`https://thetutor.link/?ref=catchment&town=${encodeURIComponent(s.town)}`}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="block text-center bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-indigo-800 transition-colors"
          >
            Find a tutor near {s.town} →
          </a>
        </div>
      )}
    </aside>
  </div>
  <script is:inline>
    if (new URLSearchParams(window.location.search).get('subscribed') === '1') {
      var form = document.getElementById('catchment-email-form');
      var msg = document.getElementById('subscribed-msg');
      if (form) form.classList.add('hidden');
      if (msg) msg.classList.remove('hidden');
    }
  </script>
  {s.lat && s.lng && (
    <script is:inline define:vars={{ lat: s.lat, lng: s.lng, name: s.name }}>
      document.addEventListener('DOMContentLoaded', function() {
        var el = document.getElementById('school-map');
        if (!el || typeof L === 'undefined') return;
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap',
          maxZoom: 18
        }).addTo(map);
        L.marker([lat, lng]).addTo(map).bindPopup(name).openPopup();
      });
    </script>
  )}
</Base>
