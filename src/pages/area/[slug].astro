---
import Base from '../../layouts/Base.astro';
import schools from '../../data/schools.json';
import towns from '../../data/towns.json';
import SchoolCard from '../../components/SchoolCard.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import areaIntros from '../../data/area-intros.json';

export async function getStaticPaths() {
  return (towns as any[]).map((t: any) => ({
    params: { slug: t.slug },
    props: { town: t },
  }));
}

const { town } = Astro.props;
const areaSchools = (schools as any[]).filter((s: any) => s.townSlug === town.slug);
const primaries = areaSchools.filter((s: any) => s.phase === 'Primary');
const secondaries = areaSchools.filter((s: any) => s.phase === 'Secondary');
const others = areaSchools.filter((s: any) => s.phase !== 'Primary' && s.phase !== 'Secondary');

// Sibling areas - other towns in the same council, sorted by school count descending
const siblingAreas = (towns as any[])
  .filter((t: any) => t.laSlug === town.laSlug && t.slug !== town.slug)
  .sort((a: any, b: any) => b.count - a.count)
  .slice(0, 12);

// Thin-page guard: noindex aggregates with fewer than 10 schools.
// Jun 11 audit: pages with < 5 schools were already noindexed; pages with 5-9 schools
// generate ~150-250 unique words (below the 300-word threshold from the pSEO survival
// checklist). Raising the gate from 5 to 10 noindexes 509 of 1,096 area pages (46.4%),
// reducing the thin-page ratio from 64% to ~22% of indexed area pages.
// Data-derived demand signals - computed at build time from schools.json, unique per area.
// These turn the boilerplate "N schools" intro into entity-specific content (de-programmatic rebuild).
const withFill = areaSchools.filter((s: any) => s.capacity && s.pupils);
const oversubSchools = withFill.filter((s: any) => s.pupils >= s.capacity);
const faithSchools = areaSchools.filter((s: any) => s.religion && s.religion !== 'Does not apply' && s.religion !== 'None');
const academySchools = areaSchools.filter((s: any) => s.type?.toLowerCase().includes('academy'));
const avgFill = withFill.length
  ? Math.round(withFill.reduce((sum: number, s: any) => sum + s.pupils / s.capacity, 0) / withFill.length * 100)
  : null;
const ofstedRated = areaSchools.filter((s: any) => ['1', '2', '3', '4'].includes(String(s.ofstedRating)));
const ofstedGoodPlus = ofstedRated.filter((s: any) => s.ofstedRating === '1' || s.ofstedRating === '2').length;

// A page is "thin" if it has few schools OR no computable demand data to differentiate it.
const hasDemandData = oversubSchools.length > 0 || faithSchools.length > 0 || avgFill !== null || ofstedRated.length > 0;
const isThin = areaSchools.length < 10 || (areaSchools.length < 15 && !hasDemandData);
const robotsDirective = isThin ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';

// Data-derived H2 for the primary-schools section - varies per entity via oversubscription count.
const primaryH2 = oversubSchools.some((s: any) => s.phase === 'Primary')
  ? `Primary schools in ${town.name}: ${oversubSchools.filter((s: any) => s.phase === 'Primary').length} oversubscribed`
  : `Primary Schools in ${town.name}`;

const areaOverride = (areaIntros as Record<string, { seoTitle?: string; seoDescription?: string; paragraphs?: string[] }>)[town.slug] ?? null;
const title = areaOverride?.seoTitle ?? `${town.name} Catchment Area Schools 2026: Map & List`;
const description = areaOverride?.seoDescription ?? `All ${areaSchools.length} schools in the ${town.name} catchment area${town.la ? `, ${town.la}` : ''}. ${primaries.length > 0 ? `${primaries.length} primary` : ''}${primaries.length > 0 && secondaries.length > 0 ? ' + ' : ''}${secondaries.length > 0 ? `${secondaries.length} secondary` : ''}. Check if your address is in catchment, Ofsted ratings and admissions info.`;
const uniqueIntro = areaOverride?.paragraphs ?? null;

// ItemList schema
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Schools in ${town.name}`,
  "description": `Primary and secondary schools in ${town.name}, ${town.la}`,
  "numberOfItems": areaSchools.length,
  "itemListElement": areaSchools.slice(0, 10).map((s: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://catchment.school/school/${s.slug}`
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://catchment.school/" },
    { "@type": "ListItem", "position": 2, "name": town.la, "item": `https://catchment.school/council/${town.laSlug}` },
    { "@type": "ListItem", "position": 3, "name": `Schools in ${town.name}`, "item": `https://catchment.school/area/${town.slug}` },
  ]
};

// Top school names for the "what schools serve this area" FAQ answer
const topSchoolNames = areaSchools.slice(0, 5).map((s: any) => s.name).join(', ');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What schools serve ${town.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `There ${areaSchools.length === 1 ? 'is' : 'are'} ${areaSchools.length} school${areaSchools.length !== 1 ? 's' : ''} in ${town.name}${town.la ? `, ${town.la}` : ''}${areaSchools.length > 0 ? `, including ${topSchoolNames}${areaSchools.length > 5 ? ' and more' : ''}` : ''}. You can view each school's catchment area guidance and admissions policy on catchment.school.`
      }
    },
    {
      "@type": "Question",
      "name": `How many primary and secondary schools are in ${town.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${town.name} has ${primaries.length} primary school${primaries.length !== 1 ? 's' : ''} and ${secondaries.length} secondary school${secondaries.length !== 1 ? 's' : ''}. ${others.length > 0 ? `There ${others.length === 1 ? 'is' : 'are'} also ${others.length} other school${others.length !== 1 ? 's' : ''} (such as all-through or special schools) in the area.` : ''} All data is sourced from the Department for Education's GIAS register.`
      }
    },
    {
      "@type": "Question",
      "name": `How do I find out if my address is in a school's catchment area in ${town.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `To check whether your address falls within a school's catchment area in ${town.name}, use the postcode search tool at catchment.school. Catchment area boundaries for ${town.name} schools are set by ${town.la || 'the local authority'} and reviewed each year. You can also consult the school's admissions policy or contact the ${town.la || 'local authority'} admissions team directly for the most up-to-date boundary maps.`
      }
    },
    {
      "@type": "Question",
      "name": `Who sets catchment area boundaries for schools in ${town.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Catchment area boundaries for schools in ${town.name} are set by ${town.la || 'the local authority'} as the admissions authority. Community and voluntary-controlled schools follow the council's published admissions policy, while academies and voluntary-aided schools may set their own. Boundaries are reviewed annually and published each September for the following academic year.`
      }
    }
  ]
};
---
<Base title={title} description={description} robots={robotsDirective}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <nav class="text-sm text-gray-500 mb-6 flex gap-2 items-center flex-wrap">
    <a href="/" class="hover:underline">Home</a>
    <span>›</span>
    <a href={`/council/${town.laSlug}/`} class="hover:underline">{town.la}</a>
    <span>›</span>
    <span class="text-gray-700">{town.name}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-3">Schools in {town.name}</h1>

  <AuthorByline type="hub" />

  <!-- Filter + search bar -->
  <div class="flex flex-wrap gap-3 mb-4">
    <input id="school-search" type="text" placeholder="Search schools..." class="border rounded-lg px-3 py-2 text-sm w-full sm:w-64 focus:outline-none focus:border-indigo-500" />
    <div class="flex gap-2 text-sm">
      <button class="school-filter px-3 py-1.5 rounded-full border border-indigo-300 bg-indigo-50 text-indigo-700 font-medium" data-filter="all">All ({areaSchools.length})</button>
      {primaries.length > 0 && <button class="school-filter px-3 py-1.5 rounded-full border hover:border-indigo-300 hover:bg-indigo-50 text-gray-600" data-filter="Primary">Primary ({primaries.length})</button>}
      {secondaries.length > 0 && <button class="school-filter px-3 py-1.5 rounded-full border hover:border-indigo-300 hover:bg-indigo-50 text-gray-600" data-filter="Secondary">Secondary ({secondaries.length})</button>}
      {others.length > 0 && <button class="school-filter px-3 py-1.5 rounded-full border hover:border-indigo-300 hover:bg-indigo-50 text-gray-600" data-filter="Other">Other ({others.length})</button>}
    </div>
  </div>

  <!-- Intro paragraph - unique per town using real counts -->
  {uniqueIntro ? (
    <div class="max-w-2xl mb-8 space-y-3 text-gray-700">
      {uniqueIntro.map((p: string) => <p>{p}</p>)}
    </div>
  ) : (
    <p class="text-gray-600 mb-8 max-w-2xl">
      There {areaSchools.length === 1 ? 'is' : 'are'} <strong>{areaSchools.length} school{areaSchools.length !== 1 ? 's' : ''}</strong> in {town.name}
      {town.la ? `, ${town.la}` : ''}
      {primaries.length > 0 && secondaries.length > 0
        ? `, including ${primaries.length} primary school${primaries.length !== 1 ? 's' : ''} and ${secondaries.length} secondary school${secondaries.length !== 1 ? 's' : ''}.`
        : primaries.length > 0
          ? `, all serving primary-age pupils (ages 4-11).`
          : secondaries.length > 0
            ? `, all serving secondary-age pupils (ages 11-16+).`
            : '.'
      }
      {' '}Catchment area boundaries are set by <a href={`/council/${town.laSlug}/`} class="text-indigo-700 hover:underline font-medium">{town.la}</a> and reviewed annually. Click a school below to view its admissions guidance.
    </p>
  )}

  {!isThin && hasDemandData && (
    <section class="mb-10 max-w-2xl p-5 bg-indigo-50/50 border border-indigo-100 rounded-lg">
      <h2 class="text-xl font-semibold mb-3">School demand in {town.name}</h2>
      <div class="text-gray-700 space-y-3 text-sm">
        {avgFill !== null && (
          <p>
            Across the {withFill.length} school{withFill.length !== 1 ? 's' : ''} in {town.name} with published capacity data, the average fill rate is <strong>{avgFill}%</strong>.
            {oversubSchools.length > 0
              ? ` ${oversubSchools.length} of them ${oversubSchools.length === 1 ? 'is' : 'are'} currently at or above their published admission number, and at those schools catchment distance is likely to decide places at the next intake.`
              : ` None are currently over capacity, but catchment distance still applies in any year a school is oversubscribed.`}
          </p>
        )}
        {faithSchools.length > 0 && (
          <p>
            {faithSchools.length} school{faithSchools.length !== 1 ? 's' : ''} in {town.name} {faithSchools.length !== 1 ? 'have' : 'has'} a religious character, so faith criteria sit alongside catchment distance in {faithSchools.length !== 1 ? 'their' : 'its'} admissions {faithSchools.length !== 1 ? 'policies' : 'policy'}.
          </p>
        )}
        {academySchools.length > 0 && (
          <p>
            {academySchools.length} of the schools in {town.name} {academySchools.length !== 1 ? 'are academies that set their' : 'is an academy that sets its'} own admissions criteria independently of {town.la}, so check each school's policy directly rather than assuming the council default applies.
          </p>
        )}
        {ofstedRated.length > 0 && (
          <p>
            {ofstedRated.length} of the schools in {town.name} {ofstedRated.length !== 1 ? 'have' : 'has'} a current Ofsted rating, of which <strong>{ofstedGoodPlus}</strong> {ofstedGoodPlus !== 1 ? 'are' : 'is'} rated Good or Outstanding. Demand and catchment distance tend to be tightest at the highest-rated schools.
          </p>
        )}
      </div>
    </section>
  )}

  {primaries.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4">{primaryH2} ({primaries.length})</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {primaries.map((s: any) => <SchoolCard {...s} />)}
      </div>
    </section>
  )}

  {secondaries.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4">Secondary Schools in {town.name} ({secondaries.length})</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {secondaries.map((s: any) => <SchoolCard {...s} />)}
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4">Other Schools in {town.name} ({others.length})</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {others.map((s: any) => <SchoolCard {...s} />)}
      </div>
    </section>
  )}

  <script is:inline>
    (function() {
      var search = document.getElementById('school-search');
      var btns = document.querySelectorAll('.school-filter');
      var cards = document.querySelectorAll('.school-card');
      var sections = document.querySelectorAll('section.mb-10');
      var activeFilter = 'all';

      function applyFilters() {
        var q = (search ? search.value : '').toLowerCase();
        cards.forEach(function(c) {
          var phase = c.getAttribute('data-phase') || '';
          var name = (c.querySelector('h3') || {}).textContent || '';
          var matchPhase = activeFilter === 'all' ||
            (activeFilter === 'Other' ? (phase !== 'Primary' && phase !== 'Secondary') : phase === activeFilter);
          var matchSearch = !q || name.toLowerCase().indexOf(q) !== -1;
          c.style.display = matchPhase && matchSearch ? '' : 'none';
        });
        sections.forEach(function(sec) {
          var visible = sec.querySelectorAll('.school-card:not([style*="display: none"])');
          sec.style.display = visible.length ? '' : 'none';
        });
      }

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          activeFilter = btn.getAttribute('data-filter');
          btns.forEach(function(b) {
            b.className = b === btn
              ? 'school-filter px-3 py-1.5 rounded-full border border-indigo-300 bg-indigo-50 text-indigo-700 font-medium'
              : 'school-filter px-3 py-1.5 rounded-full border hover:border-indigo-300 hover:bg-indigo-50 text-gray-600';
          });
          applyFilters();
        });
      });

      if (search) search.addEventListener('input', applyFilters);
    })();
  </script>

  <!-- Sibling areas in same council - distributes authority between area pages -->
  {siblingAreas.length > 0 && (
    <nav class="mt-8 p-4 border border-indigo-100 bg-indigo-50/40 rounded-lg text-sm" aria-label="Other areas in this council">
      <p class="font-medium text-gray-700 mb-2">Other areas in <a href={`/council/${town.laSlug}/`} class="text-indigo-700 hover:underline">{town.la}</a></p>
      <p class="text-gray-600 mb-3">
        Schools in {town.name} fall under <a href={`/council/${town.laSlug}/`} class="text-indigo-700 hover:underline">{town.la}</a> local authority, which also covers these nearby areas:
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
        {siblingAreas.map((t: any) => (
          <li>
            <a href={`/area/${t.slug}/`} class="text-indigo-700 hover:underline">{t.name} ({t.count})</a>
          </li>
        ))}
      </ul>
      <p class="mt-3">
        <a href={`/council/${town.laSlug}/`} class="text-indigo-700 font-medium hover:underline">
          View all schools in {town.la} →
        </a>
      </p>
    </nav>
  )}

  <!-- Catchment info + CTA -->
  <div class="mt-4 p-5 bg-amber-50 border border-amber-200 rounded-lg text-sm max-w-2xl">
    <p class="text-gray-700 mb-3">
      <strong>Catchment area boundaries</strong> for schools in {town.name} are set by <a href={`/council/${town.laSlug}/`} class="font-bold text-indigo-700 hover:underline">{town.la}</a> and updated
      each year. The "last distance offered", how far the furthest successful applicant lived, changes annually
      based on the number of applications received.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={`https://www.google.com/search?q=${encodeURIComponent(town.la + ' school admissions catchment area')}`}
        target="_blank" rel="nofollow noopener"
        class="text-indigo-700 font-medium hover:underline">
        Find {town.la} admissions documents →
      </a>
      <a href="/guides/how-school-catchment-areas-work" class="text-indigo-700 font-medium hover:underline">
        How catchment areas work →
      </a>
    </div>
  </div>
</Base>
