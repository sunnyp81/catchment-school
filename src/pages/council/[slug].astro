---
import Base from '../../layouts/Base.astro';
import schools from '../../data/schools.json';
import las from '../../data/las.json';
import SchoolCard from '../../components/SchoolCard.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import councilIntros from '../../data/council-intros.json';
import admissionsUrls from '../../data/admissions-urls.json';

export async function getStaticPaths() {
  return (las as any[]).map((la: any) => ({
    params: { slug: la.slug },
    props: { la },
  }));
}

// Councils with a live-verified direct admissions URL (src/data/admissions-urls.json,
// shared with the school template) get it in place of the generic Google search CTA.
const { la } = Astro.props;
const laSchools = (schools as any[]).filter((s: any) => s.laSlug === la.slug);
const pilotAdmissionsUrl = (admissionsUrls as Record<string, string>)[la.slug] ?? null;

const byTown: Record<string, any[]> = {};
for (const s of laSchools) {
  const key = s.town || 'Other';
  if (!byTown[key]) byTown[key] = [];
  byTown[key].push(s);
}
const towns = Object.entries(byTown).sort((a, b) => b[1].length - a[1].length);

const primaries = laSchools.filter((s: any) => s.phase === 'Primary').length;
const secondaries = laSchools.filter((s: any) => s.phase === 'Secondary').length;
const townCount = Object.keys(byTown).length;

// Data-derived demand signals - computed from schools.json, unique per council.
const oversubCount = laSchools.filter((s: any) => s.capacity && s.pupils && s.pupils >= s.capacity).length;
const faithCount = laSchools.filter((s: any) => s.religion && s.religion !== 'Does not apply' && s.religion !== 'None').length;
const selectiveCount = laSchools.filter((s: any) => s.admissionsPolicy === 'Selective').length;
const ofstedRatedCount = laSchools.filter((s: any) => ['1', '2', '3', '4'].includes(String(s.ofstedRating))).length;
const ofstedGoodPlusCount = laSchools.filter((s: any) => s.ofstedRating === '1' || s.ofstedRating === '2').length;

// Unique long-form intro (top 20 LAs); fall back to null for remaining councils
const uniqueIntro = (councilIntros as Record<string, { paragraphs: string[]; seoTitle?: string; seoDescription?: string }>)[la.slug] ?? null;

const title = uniqueIntro?.seoTitle ?? `${la.name} School Catchment Areas 2026: Full Map`;
const description = uniqueIntro?.seoDescription ?? `${la.name} school catchment areas for all ${primaries} primary and ${secondaries} secondary schools across ${townCount} areas. Maps, Ofsted ratings and admissions policies for 2026.`;

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Schools in ${la.name}`,
  "numberOfItems": laSchools.length,
  "itemListElement": laSchools.slice(0, 10).map((s: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://catchment.school/school/${s.slug}`
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://catchment.school/" },
    { "@type": "ListItem", "position": 2, "name": "All Councils", "item": "https://catchment.school/council" },
    { "@type": "ListItem", "position": 3, "name": `${la.name} Schools`, "item": `https://catchment.school/council/${la.slug}` },
  ]
};

// Top town names for the "areas" FAQ answer
const topTownNames = towns.slice(0, 5).map(([name]: [string, any[]]) => name).join(', ');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How many schools are in ${la.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${la.name} has ${laSchools.length} open schools: ${primaries} primary school${primaries !== 1 ? 's' : ''} and ${secondaries} secondary school${secondaries !== 1 ? 's' : ''} across ${townCount} area${townCount !== 1 ? 's' : ''}. Data sourced from the Department for Education's Get Information About Schools (GIAS) register.`
      }
    },
    {
      "@type": "Question",
      "name": `What areas are covered by ${la.name} school catchment zones?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${la.name} administers catchment areas across ${townCount} area${townCount !== 1 ? 's' : ''}, including ${topTownNames}${townCount > 5 ? ' and more' : ''}. Each school's catchment boundary is set by the local authority and reviewed annually as part of the admissions process.`
      }
    },
    {
      "@type": "Question",
      "name": `How do school catchment areas work in ${la.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `In ${la.name}, catchment areas define a geographical zone around each school. Children living within the catchment boundary are given priority in oversubscription criteria. The exact boundary, and the "last distance offered", changes each year based on application volumes. Official catchment maps and admissions policies are published by ${la.name} council each autumn.`
      }
    },
    {
      "@type": "Question",
      "name": `Which schools in ${la.name} are oversubscribed?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oversubscription varies by school and year in ${la.name}. Popular schools typically receive more applications than available places, meaning the "last distance offered" shrinks annually. To check demand for a specific school, consult the ${la.name} admissions authority's published offer data or the school's own admissions policy.`
      }
    }
  ]
};
---
<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <nav class="text-sm text-gray-500 mb-6 flex gap-2 items-center">
    <a href="/" class="hover:underline">Home</a>
    <span>›</span>
    <a href="/council" class="hover:underline">All Councils</a>
    <span>›</span>
    <span class="text-gray-700">{la.name}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-3">{la.name} School Catchment Areas</h1>

  <AuthorByline type="hub" />

  <!-- Intro paragraph - unique per LA using real counts -->
  {uniqueIntro ? (
    <div class="max-w-2xl mb-2 space-y-3 text-gray-700">
      {uniqueIntro.paragraphs.map((p: string) => <p>{p}</p>)}
    </div>
  ) : (
    <p class="text-gray-600 mb-2 max-w-2xl">
      <strong>{la.name}</strong> has <strong>{laSchools.length} schools</strong> across {townCount} area{townCount !== 1 ? 's' : ''},
      {primaries} primary school{primaries !== 1 ? 's' : ''} and {secondaries} secondary school{secondaries !== 1 ? 's' : ''}.
      Catchment area boundaries and admissions policies for all schools in {la.name} are reviewed annually.
    </p>
  )}
  <div class="flex gap-6 text-gray-500 mb-4 text-sm">
    <span>{laSchools.length} total</span>
    <span>{primaries} primary</span>
    <span>{secondaries} secondary</span>
    <span>{townCount} area{townCount !== 1 ? 's' : ''}</span>
  </div>

  {(oversubCount > 0 || selectiveCount > 0 || faithCount > 0) && (
    <p class="text-gray-600 mb-8 max-w-2xl text-sm">
      {oversubCount > 0 && (
        <span>Based on the latest published capacity data, <strong>{oversubCount}</strong> of the {laSchools.length} schools in {la.name} {oversubCount === 1 ? 'is' : 'are'} at or above their admission number, so catchment distance is decisive at those schools. </span>
      )}
      {selectiveCount > 0 && (
        <span>{la.name} has {selectiveCount} selective school{selectiveCount !== 1 ? 's' : ''} that admit by entrance test rather than distance. </span>
      )}
      {faithCount > 0 && (
        <span>{faithCount} school{faithCount !== 1 ? 's' : ''} {faithCount !== 1 ? 'apply' : 'applies'} faith-based criteria alongside catchment distance. </span>
      )}
      {ofstedRatedCount > 0 && (
        <span>Of the {ofstedRatedCount} {la.name} school{ofstedRatedCount !== 1 ? 's' : ''} with a current Ofsted rating, <strong>{ofstedGoodPlusCount}</strong> {ofstedGoodPlusCount !== 1 ? 'are' : 'is'} rated Good or Outstanding.</span>
      )}
    </p>
  )}

  <!-- Admissions CTA -->
  <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-5 mb-8 flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex-1">
      <h2 class="font-semibold mb-1">{la.name} Catchment Area Documents</h2>
      <p class="text-sm text-gray-600">
        Official admissions policies and catchment boundary maps for {la.name} schools are published annually.
        {pilotAdmissionsUrl && (
          <> The council publishes oversubscription criteria, last-distance figures, and appeals timetables on its dedicated admissions page.</>
        )}
      </p>
    </div>
    <a
      href={pilotAdmissionsUrl ?? `https://www.google.com/search?q=${encodeURIComponent(la.name + ' school admissions catchment area policy ' + new Date().getFullYear())}`}
      target="_blank"
      rel={pilotAdmissionsUrl ? 'noopener noreferrer' : 'nofollow noopener'}
      class="shrink-0 bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-indigo-800 transition-colors"
    >
      {pilotAdmissionsUrl ? `${la.name} admissions (official) →` : 'Find admissions documents →'}
    </a>
  </div>

  <!-- Area quick-nav - links council authority to all its area pages -->
  {towns.length > 1 && (
    <nav class="mb-8 p-4 border border-indigo-100 bg-indigo-50/40 rounded-lg" aria-label="Areas in this council">
      <p class="font-medium text-gray-700 mb-2">Areas in {la.name}</p>
      <p class="text-sm text-gray-600 mb-3">
        {la.name} administers school catchment areas across {townCount} area{townCount !== 1 ? 's' : ''}. Select an area to see all schools and catchment boundary guidance.
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
        {towns.map(([tName, tSchools]) => (
          <li>
            <a href={`/area/${tSchools[0].townSlug}/`} class="text-indigo-700 hover:underline">{tName} ({tSchools.length})</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- Schools by town - H2 includes location -->
  {towns.map(([townName, townSchools]) => (
    <section class="mb-10">
      <div class="flex items-baseline gap-3 mb-4">
        <h2 class="text-xl font-semibold">
          <a href={`/area/${townSchools[0].townSlug}/`} class="hover:text-indigo-700">{`Schools in ${townName}`}</a>
        </h2>
        <span class="text-sm text-gray-400">{townSchools.length} school{townSchools.length !== 1 ? 's' : ''}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {townSchools.slice(0, 12).map((s: any) => <SchoolCard {...s} />)}
      </div>
      {townSchools.length > 12 && (
        <p class="mt-3 text-sm text-gray-500">
          Showing 12 of {townSchools.length}.{' '}
          <a href={`/area/${townSchools[0].townSlug}/`} class="text-indigo-700 hover:underline">
            View all schools in {townName} →
          </a>
        </p>
      )}
    </section>
  ))}
</Base>
