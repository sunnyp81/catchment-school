---
interface Props {
  type?: 'guide' | 'hub' | 'home' | 'school';
  lastUpdated?: string; // optional override, ISO date
}

const { type = 'hub', lastUpdated } = Astro.props;

// Default: pipeline updated March 2026 (matches trust bar in Base.astro)
const iso = lastUpdated ?? '2026-03-15';
const [year, month, day] = iso.split('-').map(Number);
const reviewedDate = new Date(year, month - 1, day).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const label = type === 'guide' ? 'Written' : 'Reviewed';
---

<div class="flex items-center gap-2 text-sm text-gray-500 mb-6 pb-4 border-b border-gray-100">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
    <path d="M2 14c0-3.314 2.686-5 6-5s6 1.686 6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
  <span>
    {label} by the <a href="/editorial-policy/" class="underline hover:text-gray-700">catchment.school editorial team</a>
    · Last updated {reviewedDate}
  </span>
</div>
