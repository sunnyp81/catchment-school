---
import { fmt } from '../lib/councilstats';
interface Row { slug: string; name: string; v: number; n: number; x?: number | null }
interface Props { rows: Row[]; caption: string; valueHeader: string; dp?: number; unit?: string; extraHeader?: string; extraDp?: number; extraUnit?: string; limit?: number }
const { rows, caption: base, valueHeader, dp = 1, unit = '', extraHeader, extraDp = 1, extraUnit = '', limit } = Astro.props;
// A list runs past its limit when councils tie with the last place; say so in the caption.
const caption = limit && rows.length > limit ? `${base}, with ties` : base;
const th = 'p-2 font-medium text-gray-700 text-right align-bottom';
---
<div class="overflow-x-auto" role="region" aria-label={caption} tabindex="0">
  <table class="w-full min-w-[300px] text-sm border border-gray-200">
    <caption class="text-left text-sm font-semibold text-gray-900 p-2 bg-white">{caption}</caption>
    <thead class="bg-gray-50"><tr>
      <th scope="col" class="p-2 text-left font-medium text-gray-700">Council</th>
      <th scope="col" class={th}>{valueHeader}</th>
      {extraHeader && <th scope="col" class={th}>{extraHeader}</th>}
    </tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-t border-gray-100">
          <th scope="row" class="p-2 text-left font-medium"><a class="text-indigo-700 underline" href={`/council/${r.slug}/`}>{r.name}</a></th>
          <td class="p-2 text-right font-semibold whitespace-nowrap">{fmt(r.v, dp)}{unit}</td>
          {extraHeader && <td class="p-2 text-right whitespace-nowrap">{r.x == null ? 'No data' : `${fmt(r.x, extraDp)}${extraUnit}`}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>
